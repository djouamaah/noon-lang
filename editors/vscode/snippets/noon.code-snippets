{
  "دالة": {
    "prefix": [
      "دالة",
      "dala"
    ],
    "body": [
      "دالة ${1:الاسم}(${2:الوسائط}) {",
      "\t$0",
      "}"
    ],
    "description": "تعريف دالة"
  },
  "دالة مجهولة": {
    "prefix": [
      "دالة مجهولة",
      "lambda"
    ],
    "body": [
      "دالة(${1:س}) { أرجع $0 }"
    ],
    "description": "دالة بلا اسم تُمرَّر قيمةً"
  },
  "صنف": {
    "prefix": [
      "صنف",
      "sinf"
    ],
    "body": [
      "صنف ${1:الاسم} {",
      "\tتهيئة(${2:الوسائط}) {",
      "\t\tهذا.${2} = ${2}",
      "\t}",
      "",
      "\tنص() {",
      "\t\tأرجع \"${1}\"",
      "\t}",
      "}"
    ],
    "description": "تعريف صنف مع بانٍ وتابع نصّ"
  },
  "صنف يرث": {
    "prefix": [
      "صنف يرث",
      "yarith"
    ],
    "body": [
      "صنف ${1:الابن} يرث ${2:الأب} {",
      "\tتهيئة(${3:الوسائط}) {",
      "\t\tالأصل.تهيئة(${3})",
      "\t}$0",
      "}"
    ],
    "description": "صنف يرث صنفًا آخر"
  },
  "إذا": {
    "prefix": [
      "إذا",
      "itha"
    ],
    "body": [
      "إذا (${1:الشرط}) {",
      "\t$0",
      "}"
    ],
    "description": "شرط"
  },
  "إذا وإلا": {
    "prefix": [
      "إذا وإلا",
      "itha-willa"
    ],
    "body": [
      "إذا (${1:الشرط}) {",
      "\t$2",
      "} وإلا {",
      "\t$0",
      "}"
    ],
    "description": "شرط وبديله"
  },
  "لكل": {
    "prefix": [
      "لكل",
      "likul"
    ],
    "body": [
      "لكل ${1:عنصر} في ${2:القائمة} {",
      "\t$0",
      "}"
    ],
    "description": "حلقة على عناصر"
  },
  "لكل مدى": {
    "prefix": [
      "لكل مدى",
      "mada"
    ],
    "body": [
      "لكل ${1:ع} في مدى(${2:١٠}) {",
      "\t$0",
      "}"
    ],
    "description": "حلقة على مدى أعداد"
  },
  "طالما": {
    "prefix": [
      "طالما",
      "talama"
    ],
    "body": [
      "طالما (${1:الشرط}) {",
      "\t$0",
      "}"
    ],
    "description": "حلقة شرطية"
  },
  "حاول": {
    "prefix": [
      "حاول",
      "hawil"
    ],
    "body": [
      "حاول {",
      "\t$1",
      "} امسك (${2:خطأ_}) {",
      "\t$0",
      "}"
    ],
    "description": "معالجة الأخطاء"
  },
  "اطبع": {
    "prefix": [
      "اطبع",
      "itba"
    ],
    "body": [
      "اطبع($0)"
    ],
    "description": "طباعة سطر"
  },
  "متغير": {
    "prefix": [
      "متغير",
      "mut"
    ],
    "body": [
      "متغير ${1:الاسم} = ${2:عدم}"
    ],
    "description": "تصريح متغيّر"
  },
  "ثابت": {
    "prefix": [
      "ثابت",
      "thabit"
    ],
    "body": [
      "ثابت ${1:الاسم} = ${2:عدم}"
    ],
    "description": "تصريح ثابت"
  }
}
