# رياضيات — أوّل وحدة في مكتبة «نون» القياسية، مكتوبة بـ«نون» نفسها.
#
#     متغير ر = استورد("رياضيات")
#     اطبع(ر.عاملي(٥)، ر.قاسم_مشترك(١٢، ١٨))      # 120 6
#
# الأعداد الصحيحة تبقى صحيحة مهما كبرت (عاملي(٥٠) دقيق)، والإحصاء على
# قوائم الأعداد. ما يبدأ اسمه بـ«_» داخلي لا يُصدَّر.

ثابت ه = 2.718281828459045              # أساس اللوغاريتم الطبيعي
ثابت نسبة_ذهبية = 1.618033988749895     # (١ + جذر(٥)) / ٢


# ——— أدوات داخلية ———

دالة _صحيح(ن) {
    أرجع نوع(ن) == "عدد" و ن == أرضية(ن)
}

دالة _صحيح_غير_سالب(ن، دالة_) {
    تحقّق(_صحيح(ن) و ن >= ٠، "«" + دالة_ + "» تحتاج عددًا صحيحًا غير سالب، لا " + نص(ن))
}

دالة _قائمة_أعداد(ق، دالة_) {
    تحقّق(نوع(ق) == "قائمة" و طول(ق) > ٠، "«" + دالة_ + "» تحتاج قائمة أعداد غير فارغة")
    لكل س في ق {
        تحقّق(نوع(س) == "عدد"، "«" + دالة_ + "» تحتاج أعدادًا، ووجدت " + نص(س))
    }
}


# ——— الأعداد الصحيحة ———

# ن! = ١ × ٢ × … × ن
دالة عاملي(ن) {
    _صحيح_غير_سالب(ن، "عاملي")
    متغير ناتج = ١
    لكل ك في مدى(٢، ن + ١) { ناتج *= ك }
    أرجع ناتج
}

# عدد طرق اختيار ك عناصر من ن دون ترتيب
دالة توافيق(ن، ك) {
    _صحيح_غير_سالب(ن، "توافيق")
    _صحيح_غير_سالب(ك، "توافيق")
    إذا (ك > ن) { أرجع ٠ }
    ك = أدنى(ك، ن - ك)
    متغير ناتج = ١
    لكل ط في مدى(١، ك + ١) {
        ناتج = ناتج * (ن - ك + ط) // ط     # القسمة تامّة في كل خطوة
    }
    أرجع ناتج
}

# عدد طرق اختيار ك عناصر من ن مرتّبةً
دالة تباديل(ن، ك) {
    _صحيح_غير_سالب(ن، "تباديل")
    _صحيح_غير_سالب(ك، "تباديل")
    إذا (ك > ن) { أرجع ٠ }
    متغير ناتج = ١
    لكل ط في مدى(ن - ك + ١، ن + ١) { ناتج *= ط }
    أرجع ناتج
}

# القاسم المشترك الأكبر، بخوارزمية إقليدس
دالة قاسم_مشترك(أ، ب) {
    تحقّق(_صحيح(أ) و _صحيح(ب)، "«قاسم_مشترك» تحتاج عددين صحيحين")
    أ = مطلق(أ)
    ب = مطلق(ب)
    طالما (ب != ٠) {
        متغير باقي = أ % ب
        أ = ب
        ب = باقي
    }
    أرجع أ
}

# المضاعف المشترك الأصغر
دالة مضاعف_مشترك(أ، ب) {
    تحقّق(_صحيح(أ) و _صحيح(ب)، "«مضاعف_مشترك» تحتاج عددين صحيحين")
    إذا (أ == ٠ أو ب == ٠) { أرجع ٠ }
    أرجع مطلق(أ * ب) // قاسم_مشترك(أ، ب)
}

دالة زوجي(ن) { أرجع _صحيح(ن) و ن % ٢ == ٠ }

دالة فردي(ن) { أرجع _صحيح(ن) و ن % ٢ == ١ }

# أكبر صحيح مربّعه لا يتجاوز ن، دقيق للأعداد الكبيرة أيضًا
دالة جذر_صحيح(ن) {
    _صحيح_غير_سالب(ن، "جذر_صحيح")
    إذا (ن < ٢) { أرجع ن }
    متغير س = ن
    متغير ص = (س + ١) // ٢
    طالما (ص < س) {                        # طريقة نيوتن بالأعداد الصحيحة
        س = ص
        ص = (س + ن // س) // ٢
    }
    أرجع س
}

دالة أولي(ن) {
    إذا (ليس _صحيح(ن) أو ن < ٢) { أرجع خطأ }
    إذا (ن < ٤) { أرجع صحيح }
    إذا (ن % ٢ == ٠ أو ن % ٣ == ٠) { أرجع خطأ }
    متغير ق = ٥                            # القواسم الممكنة بعدها على صورة ٦ك ± ١
    طالما (ق * ق <= ن) {
        إذا (ن % ق == ٠ أو ن % (ق + ٢) == ٠) { أرجع خطأ }
        ق += ٦
    }
    أرجع صحيح
}

# الأعداد الأولية حتى «حد» شاملًا، بغربال إراتوستينس
دالة الأعداد_الأولية(حد) {
    _صحيح_غير_سالب(حد، "الأعداد_الأولية")
    إذا (حد < ٢) { أرجع [] }
    متغير مرشح = [صحيح] * (حد + ١)
    مرشح[٠] = خطأ
    مرشح[١] = خطأ
    متغير ع = ٢
    طالما (ع * ع <= حد) {
        إذا (مرشح[ع]) {
            لكل م في مدى(ع * ع، حد + ١، ع) { مرشح[م] = خطأ }
        }
        ع += ١
    }
    متغير أوليات = []
    لكل ع في مدى(٢، حد + ١) {
        إذا (مرشح[ع]) { أوليات.أضف(ع) }
    }
    أرجع أوليات
}

# العوامل الأولية مكرّرةً بتكرارها: عوامل_أولية(١٢) هي [٢، ٢، ٣]
دالة عوامل_أولية(ن) {
    _صحيح_غير_سالب(ن، "عوامل_أولية")
    متغير عوامل = []
    متغير ق = ٢
    طالما (ق * ق <= ن) {
        طالما (ن % ق == ٠) {
            عوامل.أضف(ق)
            ن = ن // ق
        }
        ق += ١
    }
    إذا (ن > ١) { عوامل.أضف(ن) }
    أرجع عوامل
}

# العدد رقم ن في متتالية فيبوناتشي: ٠، ١، ١، ٢، ٣، ٥، …
دالة فيبوناتشي(ن) {
    _صحيح_غير_سالب(ن، "فيبوناتشي")
    متغير أ = ٠
    متغير ب = ١
    لكل _ في مدى(ن) {
        متغير تالي = أ + ب
        أ = ب
        ب = تالي
    }
    أرجع أ
}

# (أساس ** أس) % مقسوم دون حساب القوّة كاملة
دالة قوة_بباقي(أساس، أس، مقسوم) {
    _صحيح_غير_سالب(أس، "قوة_بباقي")
    تحقّق(_صحيح(أساس) و _صحيح(مقسوم) و مقسوم > ٠، "«قوة_بباقي» تحتاج أعدادًا صحيحة ومقسومًا موجبًا")
    متغير ناتج = ١ % مقسوم
    أساس = أساس % مقسوم
    طالما (أس > ٠) {
        إذا (أس % ٢ == ١) { ناتج = ناتج * أساس % مقسوم }
        أساس = أساس * أساس % مقسوم
        أس = أس // ٢
    }
    أرجع ناتج
}


# ——— الإحصاء ———

دالة متوسط(ق) {
    _قائمة_أعداد(ق، "متوسط")
    أرجع مجموع(ق) / طول(ق)
}

# القيمة الوسطى بعد الترتيب، أو متوسط القيمتين الوسطيين
دالة وسيط(ق) {
    _قائمة_أعداد(ق، "وسيط")
    متغير مرتبة = فرز(ق)
    متغير نصف = طول(مرتبة) // ٢
    إذا (طول(مرتبة) % ٢ == ١) { أرجع مرتبة[نصف] }
    أرجع (مرتبة[نصف - ١] + مرتبة[نصف]) / ٢
}

# القيمة الأكثر تكرارًا؛ عند التساوي أوّلها ظهورًا
دالة منوال(ق) {
    _قائمة_أعداد(ق، "منوال")
    متغير عدادات = {}
    متغير أفضل = ق[٠]
    لكل س في ق {
        متغير مفتاح = نص(س)
        إذا (مفتاح في عدادات) { عدادات[مفتاح] += ١ } وإلا { عدادات[مفتاح] = ١ }
        إذا (عدادات[مفتاح] > عدادات[نص(أفضل)]) { أفضل = س }
    }
    أرجع أفضل
}

# تباين المجتمع: متوسط مربّعات البعد عن المتوسط
دالة تباين(ق) {
    _قائمة_أعداد(ق، "تباين")
    متغير م = متوسط(ق)
    متغير مجموع_ = ٠
    لكل س في ق { مجموع_ += (س - م) ** ٢ }
    أرجع مجموع_ / طول(ق)
}

دالة انحراف_معياري(ق) {
    أرجع جذر(تباين(ق))
}


# ——— متفرّقات ———

# -١ أو ٠ أو ١
دالة إشارة(س) {
    إذا (س > ٠) { أرجع ١ }
    إذا (س < ٠) { أرجع -١ }
    أرجع ٠
}

# س محصورًا بين «من» و«إلى»
دالة مقيد(س، من، إلى) {
    تحقّق(من <= إلى، "«مقيد»: الحدّ الأدنى أكبر من الأعلى")
    إذا (س < من) { أرجع من }
    إذا (س > إلى) { أرجع إلى }
    أرجع س
}
