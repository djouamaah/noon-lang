# نصوص — وحدة من مكتبة «نون» القياسية، مكتوبة بـ«نون» نفسها.
#
#     متغير ن = استورد("نصوص")
#     اطبع(ن.كلمات("السلام عليكم، يا هند!"))     # ["السلام"، "عليكم"، "يا"، "هند"]
#     اطبع(ن.بلا_تشكيل("مُحَمَّدٌ"))                # محمد
#
# تكمل توابع النصوص المدمجة (قص، تقسيم، استبدل، موضع…) بما يلزم للنصّ العربي
# خاصّة: التشكيل والهمزات والأرقام الثلاثة. «هجائي» يعرف الحروف العربية
# واللاتينية فقط، لا كل أبجديات يونيكود.


# ——— أدوات داخلية ———

دالة _نص(س، دالة_) {
    تحقّق(نوع(س) == "نص"، "«" + دالة_ + "» تحتاج نصًّا، لا " + نص(س))
}

دالة _صحيح_غير_سالب(ن، اسم، دالة_) {
    تحقّق(نوع(ن) == "عدد" و ن == أرضية(ن) و ن >= ٠،
        "«" + دالة_ + "»: " + اسم + " يجب أن يكون عددًا صحيحًا غير سالب")
}

دالة _محرف_واحد(ح، دالة_) {
    تحقّق(نوع(ح) == "نص" و طول(ح) == ١، "«" + دالة_ + "»: محرف الحشو حرف واحد")
}

# هل كل محرف في «س» يحقّق «شرط»؟ والنصّ الفارغ لا يحقّق شيئًا. مع «مع_التشكيل»
# يُتجاوز التشكيل والتطويل، فـ«مَرحبا» عربية؛ ويبقى لازمًا حرفٌ واحد على الأقل
دالة _كلّه(س، شرط، دالة_، مع_التشكيل = خطأ) {
    _نص(س، دالة_)
    متغير وجد = خطأ
    لكل ح في س {
        متغير ر = رمز(ح)
        إذا (مع_التشكيل و (_تشكيل(ر) أو ر == _تطويل)) { استمر }
        إذا (ليس شرط(ر)) { أرجع خطأ }
        وجد = صحيح
    }
    أرجع وجد
}

دالة _هجائي(ر) {
    أرجع (ر >= ٦٥ و ر <= ٩٠) أو (ر >= ٩٧ و ر <= ١٢٢) أو (ر >= ١٩٢ و ر <= ٥٩١ و ر != ٢١٥ و ر != ٢٤٧) أو _عربي(ر)
}

# حروف العربية وما زادته الفارسية والأردية عليها، بلا التشكيل ولا الأرقام
دالة _عربي(ر) {
    # ١٦٤٨ (الألف الخنجرية) تشكيل لا حرف، فالمدى ١٦٤٦–١٧٤٧ يُقطع عندها
    أرجع ((ر >= ١٥٦٩ و ر <= ١٥٩٤) أو (ر >= ١٦٠١ و ر <= ١٦١٠) أو ر == ١٦٤٦ أو ر == ١٦٤٧
        أو (ر >= ١٦٤٩ و ر <= ١٧٤٧) أو ر == ١٧٤٩ أو (ر >= ١٧٨٦ و ر <= ١٧٩١))
}

دالة _رقمي(ر) {
    أرجع (ر >= ٤٨ و ر <= ٥٧) أو (ر >= ١٦٣٢ و ر <= ١٦٤١) أو (ر >= ١٧٧٦ و ر <= ١٧٨٥)
}

# الفتحتان إلى السكون، والشدّة، والمدّة، والهمزتان فوق الحرف وتحته، والألف الخنجرية
دالة _تشكيل(ر) {
    أرجع (ر >= ١٦١١ و ر <= ١٦٣١) أو ر == ١٦٤٨
}

دالة _مسافة(ر) {
    أرجع ر == ٣٢ أو ر == ٩ أو ر == ١٠ أو ر == ١٣ أو ر == ١١ أو ر == ١٢ أو ر == ١٦٠ أو ر == ٨٢٣٩ أو ر == ١٢٢٨٨ أو (ر >= ٨١٩٢ و ر <= ٨٢٠٢)
}

ثابت _تطويل = ١٦٠٠


# ——— فحص المحارف ———

# هل النصّ كله حروف؟ (العربية واللاتينية، والتشكيل لا يُخرجه منها)
دالة هجائي(س) { أرجع _كلّه(س، _هجائي، "هجائي"، صحيح) }

# هل النصّ كله حروف عربية؟ التشكيل لا يُخرجه منها
دالة عربي(س) { أرجع _كلّه(س، _عربي، "عربي"، صحيح) }

# هل النصّ كله أرقام؟ اللاتينية ٠-٩ والعربية-الهندية والفارسية سواء
دالة رقمي(س) { أرجع _كلّه(س، _رقمي، "رقمي") }

دالة مسافة(س) { أرجع _كلّه(س، _مسافة، "مسافة") }


# ——— الأسطر والكلمات ———

# الأسطر بلا محارف نهايتها؛ يقبل \n و\r\n و\r
دالة أسطر(س) {
    _نص(س، "أسطر")
    متغير ناتج = []
    متغير سطر = ""
    متغير ط = ٠
    طالما (ط < طول(س)) {
        متغير ح = س[ط]
        إذا (ح == "\n" أو ح == "\r") {
            ناتج.أضف(سطر)
            سطر = ""
            إذا (ح == "\r" و ط + ١ < طول(س) و س[ط + ١] == "\n") { ط += ١ }
        } وإلا {
            سطر += ح
        }
        ط += ١
    }
    إذا (سطر != "") { ناتج.أضف(سطر) }
    أرجع ناتج
}

# الكلمات: متتاليات الحروف والأرقام، والتشكيل والتطويل جزء من الكلمة
دالة كلمات(س) {
    _نص(س، "كلمات")
    متغير ناتج = []
    متغير كلمة = ""
    لكل ح في س {
        متغير ر = رمز(ح)
        إذا (_هجائي(ر) أو _رقمي(ر) أو _تشكيل(ر) أو ر == _تطويل أو ح == "_") {
            كلمة += ح
        } وإلا إذا (كلمة != "") {
            ناتج.أضف(كلمة)
            كلمة = ""
        }
    }
    إذا (كلمة != "") { ناتج.أضف(كلمة) }
    أرجع ناتج
}

دالة عدد_الكلمات(س) { أرجع طول(كلمات(س)) }

# الكلمات بترتيب معكوس، بينها مسافة واحدة
دالة عكس_الكلمات(س) {
    أرجع عكس(كلمات(س)).وصل(" ")
}


# ——— الحشو والاقتطاع ———

دالة _حشو(س، عرض، محرف_، دالة_) {
    _نص(س، دالة_)
    _صحيح_غير_سالب(عرض، "العرض"، دالة_)
    _محرف_واحد(محرف_، دالة_)
    أرجع محرف_ * أقصى(٠، عرض - طول(س))
}

# يُطيل النصّ إلى «عرض» بمحارف قبله (يمينه في العربية)
دالة حشو_البداية(س، عرض، محرف_ = " ") {
    أرجع _حشو(س، عرض، محرف_، "حشو_البداية") + س
}

# يُطيل النصّ إلى «عرض» بمحارف بعده (يساره في العربية)
دالة حشو_النهاية(س، عرض، محرف_ = " ") {
    أرجع س + _حشو(س، عرض، محرف_، "حشو_النهاية")
}

# النصّ في وسط «عرض»؛ الزائد الفردي بعده
دالة توسيط(س، عرض، محرف_ = " ") {
    متغير حشو = _حشو(س، عرض، محرف_، "توسيط")
    متغير قبل = طول(حشو) // ٢
    أرجع حشو[:قبل] + س + حشو[قبل:]
}

# النصّ في «حد» محارف على الأكثر، واللاحقة في آخره إن قُصّ
دالة اقتطع(س، حد، لاحقة = "…") {
    _نص(س، "اقتطع")
    _صحيح_غير_سالب(حد، "الحدّ"، "اقتطع")
    إذا (طول(س) <= حد) { أرجع س }
    إذا (حد <= طول(لاحقة)) { أرجع س[:حد] }
    أرجع س[:حد - طول(لاحقة)] + لاحقة
}


# ——— البحث ———

# كل مواضع «مقطع» في النصّ، دون تداخل
دالة مواضع(س، مقطع) {
    _نص(س، "مواضع")
    _نص(مقطع، "مواضع")
    تحقّق(طول(مقطع) > ٠، "«مواضع»: المقطع المبحوث عنه فارغ")
    متغير ناتج = []
    متغير بداية = ٠
    طالما (صحيح) {
        متغير موضع_ = س[بداية:].موضع(مقطع)
        إذا (موضع_ < ٠) { توقف }
        ناتج.أضف(بداية + موضع_)
        بداية = بداية + موضع_ + طول(مقطع)
    }
    أرجع ناتج
}

دالة عدد_مرات(س، مقطع) {
    _نص(س، "عدد_مرات")
    _نص(مقطع، "عدد_مرات")
    تحقّق(طول(مقطع) > ٠، "«عدد_مرات»: المقطع المبحوث عنه فارغ")
    أرجع طول(مواضع(س، مقطع))
}

# عدد مرّات كل محرف، بترتيب أوّل ظهوره
دالة تكرار_المحارف(س) {
    _نص(س، "تكرار_المحارف")
    متغير عدادات = {}
    لكل ح في س {
        إذا (ح في عدادات) { عدادات[ح] += ١ } وإلا { عدادات[ح] = ١ }
    }
    أرجع عدادات
}


# ——— النصّ العربي ———

# يحذف الحركات والتنوين والشدّة والسكون والتطويل
دالة بلا_تشكيل(س) {
    _نص(س، "بلا_تشكيل")
    متغير ناتج = ""
    لكل ح في س {
        متغير ر = رمز(ح)
        إذا (ليس _تشكيل(ر) و ر != _تطويل) { ناتج += ح }
    }
    أرجع ناتج
}

ثابت _الهمزات = {"أ": "ا"، "إ": "ا"، "آ": "ا"، "ٱ": "ا"، "ى": "ي"، "ة": "ه"}

# يوحّد صور الألف والياء والتاء المربوطة للبحث: «إسلام» و«اسلام» سواء
دالة وحد_الهمزات(س) {
    _نص(س، "وحد_الهمزات")
    متغير ناتج = ""
    لكل ح في س {
        إذا (ح في _الهمزات) { ناتج += _الهمزات[ح] } وإلا { ناتج += ح }
    }
    أرجع ناتج
}

# هل النصّان واحد إذا أُهمل التشكيل وصور الهمزات والتاء المربوطة؟
دالة متشابهان(أ، ب) {
    أرجع وحد_الهمزات(بلا_تشكيل(أ)) == وحد_الهمزات(بلا_تشكيل(ب))
}

# هل يُقرأ النصّ من آخره كما يُقرأ من أوّله؟ بإهمال المسافات والتشكيل والترقيم
دالة متناظر(س) {
    متغير حروف = كلمات(وحد_الهمزات(بلا_تشكيل(س))).وصل("")
    أرجع طول(حروف) > ٠ و حروف == عكس(حروف)
}

دالة _حوّل_أرقام(س، بداية، دالة_) {
    _نص(س، دالة_)
    متغير ناتج = ""
    لكل ح في س {
        متغير ر = رمز(ح)
        إذا (ر >= ٤٨ و ر <= ٥٧) { ناتج += محرف(بداية + ر - ٤٨) }
        وإلا إذا (ر >= ١٦٣٢ و ر <= ١٦٤١) { ناتج += محرف(بداية + ر - ١٦٣٢) }
        وإلا إذا (ر >= ١٧٧٦ و ر <= ١٧٨٥) { ناتج += محرف(بداية + ر - ١٧٧٦) }
        وإلا { ناتج += ح }
    }
    أرجع ناتج
}

# ٠١٢٣ (والفارسية) ← 0123
دالة أرقام_لاتينية(س) { أرجع _حوّل_أرقام(س، ٤٨، "أرقام_لاتينية") }

# 0123 (والفارسية) ← ٠١٢٣
دالة أرقام_هندية(س) { أرجع _حوّل_أرقام(س، ١٦٣٢، "أرقام_هندية") }


# ——— القوالب ———

# يملأ {اسم} في النصّ من قاموس، أو {٠} من قائمة؛ و{{ و}} تُكتبان { و}
دالة قالب(س، قيم) {
    _نص(س، "قالب")
    تحقّق(نوع(قيم) == "قاموس" أو نوع(قيم) == "قائمة"، "«قالب» تأخذ قيمها من قاموس أو قائمة")
    متغير ناتج = ""
    متغير ط = ٠
    طالما (ط < طول(س)) {
        متغير ح = س[ط]
        إذا (ح == "{" و ط + ١ < طول(س) و س[ط + ١] == "{") {
            ناتج += "{"
            ط += ٢
            استمر
        }
        إذا (ح == "}" و ط + ١ < طول(س) و س[ط + ١] == "}") {
            ناتج += "}"
            ط += ٢
            استمر
        }
        إذا (ح == "{") {
            متغير نهاية = س[ط:].موضع("}")
            تحقّق(نهاية > ٠، "«قالب»: «{» بلا «}» تغلقه")
            متغير مفتاح = س[ط + ١:ط + نهاية].قص()
            ناتج += نص(_قيمة_المفتاح(قيم، مفتاح))
            ط += نهاية + ١
            استمر
        }
        ناتج += ح
        ط += ١
    }
    أرجع ناتج
}

دالة _قيمة_المفتاح(قيم، مفتاح) {
    إذا (نوع(قيم) == "قاموس") {
        تحقّق(مفتاح في قيم، "«قالب»: لا قيمة للمفتاح «" + مفتاح + "»")
        أرجع قيم[مفتاح]
    }
    تحقّق(رقمي(مفتاح)، "«قالب»: مع القائمة تُكتب المواضع أرقامًا، لا «" + مفتاح + "»")
    متغير رقم = عدد(أرقام_لاتينية(مفتاح))
    تحقّق(رقم < طول(قيم)، "«قالب»: لا عنصر في الموضع " + نص(رقم))
    أرجع قيم[رقم]
}
