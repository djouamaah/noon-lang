# ══════════════════════════════════════════════════════════════════════════
#  نون بنون: مُفسِّر لغة «نون» مكتوب بـ«نون» نفسها
# ══════════════════════════════════════════════════════════════════════════
#
#  الاستعمال:
#      noon selfhost/noon.noon برنامج.noon [وسائط البرنامج…]
#
#  ثلاث مراحل كما في المُفسِّر الأصلي (noon/lexer.py وparser.py وinterpreter.py):
#  تحليل لفظي يحوّل النصّ إلى رموز، وتحليل نحوي يبني منها شجرة، ومُنفِّذ يمشي
#  على الشجرة.
#
#  الأعداد والنصوص والقوائم والقواميس قيمُ اللغة المضيفة نفسها، فتُستعمل
#  دوالّها المدمجة كما هي. أما الدوال والأصناف والكائنات فقواميس تحمل مفتاحًا
#  داخليًّا لا يصنعه برنامج عادي.
#
#  tests/test_selfhost.py يشغّل بهذا المُفسِّر الأمثلة وكل كتل التوثيق وبرامج
#  صعبة، ويقارن ناتجه بالمُفسِّر الأصلي حرفًا بحرف.
#
#  لا يستعمل هذا الملف الشرطة المائلة ولا التهريب: المحارف الخاصّة تُصنع بـ«محرف».


# ═══════════════════════════ ثوابت مشتركة ═══════════════════════════

ثابت سطر_جديد = محرف(10)
ثابت جدولة = محرف(9)
ثابت رجوع_السطر = محرف(13)
ثابت شرطة_مائلة = محرف(92)
ثابت تنصيص = محرف(34)
ثابت تنصيص_مفرد = محرف(39)

# مفاتيح داخلية تبدأ بمحرف الصفر
ثابت علامة = محرف(0) + "نون"
ثابت علامة_رمية = محرف(0) + "رمية"
ثابت علامة_خطأ = محرف(0) + "خطأ"
ثابت علامة_نحوي = محرف(0) + "نحوي"

ثابت فاصل_الدفعة = محرف(0) + "═══ نهاية البرنامج ═══"

متغير السطر_الحالي = ٠
متغير عداد_الهويات = ٠
متغير وسائط_البرنامج = []


دالة خطأ_تشغيل(رسالة، سطر) {
    ارمِ {علامة_خطأ: رسالة، "سطر": سطر}
}

دالة خطأ_نحوي(رسالة، سطر) {
    ارمِ {علامة_نحوي: رسالة، "سطر": سطر}
}

# «%d» في بايثون: أرقام لاتينية دائمًا، ولو فُعّلت الأرقام العربية للعرض
دالة رقم_لاتيني(ن) {
    إذا (ن < ٠) { أرجع "-" + رقم_لاتيني(-ن) }
    إذا (ن < ١٠) { أرجع محرف(48 + ن) }
    أرجع رقم_لاتيني(ن // ١٠) + محرف(48 + ن % ١٠)
}


# ═══════════════════════════ التحليل اللفظي ═══════════════════════════

# توحيد الهمزات والألف المقصورة والتاء، وحذف التطويل. التشكيل لا يُحذف.
دالة وحد(كلمة) {
    متغير ناتج = ""
    لكل ح في كلمة {
        إذا (ح == "ـ") { استمر }
        إذا (ح == "أ" أو ح == "إ" أو ح == "آ" أو ح == "ٱ") { ناتج += "ا" }
        وإلا إذا (ح == "ى") { ناتج += "ي" }
        وإلا إذا (ح == "ة") { ناتج += "ه" }
        وإلا { ناتج += ح }
    }
    أرجع ناتج
}

ثابت كلمات_خام = {
    "متغير": "VAR"، "ثابت": "CONST"، "دالة": "FUNC"، "أرجع": "RETURN"،
    "إذا": "IF"، "وإلا": "ELSE"، "طالما": "WHILE"، "لكل": "FOR"، "في": "IN"،
    "توقف": "BREAK"، "استمر": "CONTINUE"، "صحيح": "TRUE"، "خطأ": "FALSE"،
    "عدم": "NULL"، "و": "AND"، "أو": "OR"، "ليس": "NOT"، "صنف": "CLASS"،
    "يرث": "EXTENDS"، "هذا": "THIS"، "الأصل": "SUPER"، "حاول": "TRY"،
    "امسك": "CATCH"، "أخيرًا": "FINALLY"، "أخيرا": "FINALLY"، "ارمِ": "THROW"،
    "ارم": "THROW"،
}

متغير الكلمات_المفتاحية = {}
لكل كلمة في كلمات_خام {
    الكلمات_المفتاحية[وحد(كلمة)] = كلمات_خام[كلمة]
}

ثابت ثنائية_المحارف = {
    "**": "POW"، "==": "EQ"، "!=": "NE"، "<=": "LE"، ">=": "GE"،
    "+=": "PLUS_EQ"، "-=": "MINUS_EQ"، "*=": "STAR_EQ"، "/=": "SLASH_EQ"،
    "//": "DSLASH"، "&&": "AND"، "||": "OR"،
}

ثابت أحادية_المحارف = {
    "+": "PLUS"، "-": "MINUS"، "*": "STAR"، "/": "SLASH"، "%": "PERCENT"،
    "=": "ASSIGN"، "<": "LT"، ">": "GT"، "!": "NOT"،
    "(": "LPAREN"، ")": "RPAREN"، "[": "LBRACKET"، "]": "RBRACKET"،
    "{": "LBRACE"، "}": "RBRACE"، ":": "COLON"، ".": "DOT"،
    ",": "COMMA"، "،": "COMMA"، ";": "NEWLINE"، "؛": "NEWLINE"،
}

متغير التهريبات = {
    "n": سطر_جديد، "t": جدولة، "r": رجوع_السطر، "0": محرف(0)،
}
التهريبات[شرطة_مائلة] = شرطة_مائلة
التهريبات[تنصيص] = تنصيص
التهريبات[تنصيص_مفرد] = تنصيص_مفرد

# الرقم اللاتيني المقابل لرقم لاتيني أو عربي-هندي أو فارسي، أو عدم
دالة رقم_عادي(ح) {
    إذا (ح == "") { أرجع عدم }
    متغير م = رمز(ح)
    إذا (م >= 48 و م <= 57) { أرجع ح }
    إذا (م >= 1632 و م <= 1641) { أرجع محرف(م - 1584) }
    إذا (م >= 1776 و م <= 1785) { أرجع محرف(م - 1728) }
    أرجع عدم
}

دالة حركة(ح) {
    متغير م = رمز(ح)
    أرجع (م >= 1611 و م <= 1621) أو م == 1648 أو م == 1750 أو م == 1600
}

# تقريب لـ str.isalpha في بايثون: الحروف اللاتينية والعربية بكتلها
دالة حرف_هجاء(ح) {
    متغير م = رمز(ح)
    إذا (م < 128) { أرجع (م >= 65 و م <= 90) أو (م >= 97 و م <= 122) }
    إذا (م >= 1568 و م <= 1610) { أرجع صحيح }
    إذا (م >= 1646 و م <= 1647) { أرجع صحيح }
    إذا (م >= 1649 و م <= 1747) { أرجع صحيح }
    إذا (م == 1749 أو م == 1765 أو م == 1766 أو م == 1774 أو م == 1775) { أرجع صحيح }
    إذا ((م >= 1786 و م <= 1788) أو م == 1791) { أرجع صحيح }
    إذا (م >= 1872 و م <= 1919) { أرجع صحيح }
    إذا (م >= 64336 و م <= 65019) { أرجع صحيح }
    إذا (م >= 65136 و م <= 65276) { أرجع صحيح }
    إذا (م == 170 أو م == 181 أو م == 186) { أرجع صحيح }
    أرجع م >= 192 و م <= 591 و م != 215 و م != 247
}

دالة ست_عشري(نص_) {
    إذا (نص_ == "") { أرجع عدم }
    متغير ناتج = ٠
    لكل ح في نص_ {
        متغير م = رمز(ح)
        إذا (م >= 48 و م <= 57) { ناتج = ناتج * ١٦ + م - 48 }
        وإلا إذا (م >= 65 و م <= 70) { ناتج = ناتج * ١٦ + م - 55 }
        وإلا إذا (م >= 97 و م <= 102) { ناتج = ناتج * ١٦ + م - 87 }
        وإلا { أرجع عدم }
    }
    أرجع ناتج
}

دالة حلل_لفظيا(مصدر) {
    متغير رموز = []
    متغير موضع = ٠
    متغير سطر = ١
    متغير عمق = ٠
    متغير نهاية = طول(مصدر)

    دالة عند(إزاحة) {
        متغير ي = موضع + إزاحة
        إذا (ي < نهاية) { أرجع مصدر[ي] }
        أرجع ""
    }

    دالة تقدم() {
        متغير ح = مصدر[موضع]
        موضع += ١
        إذا (ح == سطر_جديد) { سطر += ١ }
        أرجع ح
    }

    دالة آخر_نوع() {
        إذا (طول(رموز) == ٠) { أرجع عدم }
        أرجع رموز[-١]["نوع"]
    }

    دالة رمز_جديد(نوع_، قيمة، سطر_) {
        رموز.أضف({"نوع": نوع_، "قيمة": قيمة، "سطر": سطر_، "عشري": خطأ})
    }

    طالما (موضع < نهاية) {
        متغير ح = مصدر[موضع]

        إذا (ح == سطر_جديد) {
            متغير سطر_ = سطر
            تقدم()
            إذا (عمق == ٠ و آخر_نوع() != عدم و آخر_نوع() != "NEWLINE") {
                رمز_جديد("NEWLINE"، شرطة_مائلة + "n"، سطر_)
            }
            استمر
        }

        متغير م = رمز(ح)
        إذا (ح == " " أو ح == جدولة أو ح == رجوع_السطر أو م == 65279 أو م == 8207 أو م == 8206) {
            تقدم()
            استمر
        }

        إذا (ح == "#") {
            طالما (موضع < نهاية و مصدر[موضع] != سطر_جديد) { تقدم() }
            استمر
        }

        إذا (رقم_عادي(ح) != عدم) {
            متغير سطر_ = سطر
            متغير أرقام = ""
            متغير عشري = خطأ
            طالما (موضع < نهاية) {
                متغير ج = مصدر[موضع]
                متغير ر = رقم_عادي(ج)
                إذا (ر != عدم) {
                    أرقام += ر
                    تقدم()
                } وإلا إذا (ج == "٬" أو ج == "_") {
                    تقدم()
                } وإلا إذا ((ج == "." أو ج == "٫") و ليس عشري و رقم_عادي(عند(١)) != عدم) {
                    عشري = صحيح
                    أرقام += "."
                    تقدم()
                } وإلا {
                    توقف
                }
            }
            رمز_جديد("NUMBER"، عدد(أرقام)، سطر_)
            رموز[-١]["عشري"] = عشري
            استمر
        }

        إذا (ح == تنصيص أو ح == تنصيص_مفرد) {
            متغير سطر_ = سطر
            تقدم()
            متغير محتوى = ""
            طالما (صحيح) {
                إذا (موضع >= نهاية) { خطأ_نحوي("نصّ لم يُغلق"، سطر_) }
                متغير ج = تقدم()
                إذا (ج == ح) { توقف }
                إذا (ج == سطر_جديد) { خطأ_نحوي("نصّ لم يُغلق قبل نهاية السطر"، سطر_) }
                إذا (ج == شرطة_مائلة) {
                    متغير التالي = ""
                    إذا (موضع < نهاية) { التالي = تقدم() }
                    إذا (التالي == "u") {
                        متغير أرقام = ""
                        لكل _ في مدى(٤) {
                            إذا (موضع < نهاية) { أرقام += تقدم() }
                        }
                        متغير قيمة = ست_عشري(أرقام)
                        إذا (قيمة == عدم) { خطأ_نحوي("تهريب " + شرطة_مائلة + "u غير صالح"، سطر) }
                        محتوى += محرف(قيمة)
                    } وإلا إذا (التالي == "") {
                        محتوى += شرطة_مائلة
                    } وإلا إذا (التالي في التهريبات) {
                        محتوى += التهريبات[التالي]
                    } وإلا {
                        محتوى += شرطة_مائلة + التالي
                    }
                    استمر
                }
                محتوى += ج
            }
            رمز_جديد("STRING"، محتوى، سطر_)
            استمر
        }

        إذا (حرف_هجاء(ح) أو ح == "_") {
            متغير سطر_ = سطر
            متغير بداية = موضع
            طالما (موضع < نهاية) {
                متغير ج = مصدر[موضع]
                إذا (حرف_هجاء(ج) أو ج == "_" أو رقم_عادي(ج) != عدم أو حركة(ج)) {
                    تقدم()
                } وإلا {
                    توقف
                }
            }
            متغير كلمة = مصدر[بداية:موضع]
            متغير موحدة = وحد(كلمة)
            إذا (موحدة في الكلمات_المفتاحية) {
                رمز_جديد(الكلمات_المفتاحية[موحدة]، كلمة، سطر_)
            } وإلا {
                رمز_جديد("IDENT"، كلمة، سطر_)
            }
            استمر
        }

        متغير اثنان = مصدر[موضع:موضع + ٢]
        إذا (اثنان في ثنائية_المحارف) {
            متغير سطر_ = سطر
            تقدم()
            تقدم()
            رمز_جديد(ثنائية_المحارف[اثنان]، اثنان، سطر_)
            استمر
        }

        إذا (ح في أحادية_المحارف) {
            متغير سطر_ = سطر
            متغير نوع_ = أحادية_المحارف[ح]
            تقدم()
            إذا (ح == "(" أو ح == "[") {
                عمق += ١
            } وإلا إذا (ح == ")" أو ح == "]") {
                عمق = أقصى(٠، عمق - ١)
            }
            إذا (نوع_ == "NEWLINE" و (آخر_نوع() == عدم أو آخر_نوع() == "NEWLINE")) { استمر }
            رمز_جديد(نوع_، ح، سطر_)
            استمر
        }

        خطأ_نحوي("رمز غير معروف: «" + ح + "»"، سطر)
    }

    إذا (آخر_نوع() != عدم و آخر_نوع() != "NEWLINE") {
        رمز_جديد("NEWLINE"، شرطة_مائلة + "n"، سطر)
    }
    رمز_جديد("EOF"، عدم، سطر)
    أرجع رموز
}


# ═══════════════════════════ التحليل النحوي ═══════════════════════════

ثابت أسماء_الرموز = {
    "NEWLINE": "نهاية سطر"، "EOF": "نهاية الملف"، "IDENT": "اسم"،
    "NUMBER": "عدد"، "STRING": "نص"، "LPAREN": "("، "RPAREN": ")"،
    "LBRACE": "{"، "RBRACE": "}"، "LBRACKET": "["، "RBRACKET": "]"،
    "COMMA": "فاصلة"، "COLON": "نقطتان"، "ASSIGN": "="،
}

ثابت عمليات_الإسناد = {
    "ASSIGN": عدم، "PLUS_EQ": "+"، "MINUS_EQ": "-"، "STAR_EQ": "*"، "SLASH_EQ": "/"،
}
ثابت عمليات_المساواة = {"EQ": "=="، "NE": "!="}
ثابت عمليات_المقارنة = {"LT": "<"، "GT": ">"، "LE": "<="، "GE": ">="، "IN": "في"}
ثابت عمليات_الجمع = {"PLUS": "+"، "MINUS": "-"}
ثابت عمليات_الضرب = {"STAR": "*"، "SLASH": "/"، "PERCENT": "%"، "DSLASH": "//"}

دالة عقدة(نوع_، سطر، حقول) {
    حقول["نوع"] = نوع_
    حقول["سطر"] = سطر
    أرجع حقول
}

# «%s» في بايثون لقيمة الرمز: العدد العشري يُكتب بفاصلته دائمًا (3.0 لا 3)
دالة وصف_قيمة(ر) {
    متغير قيمة = ر["قيمة"]
    إذا (نوع(قيمة) == "عدد") {
        متغير نص_ = نص(قيمة)
        إذا (ر["عشري"] و ليس ("." في نص_)) { أرجع نص_ + ".0" }
        أرجع نص_
    }
    أرجع قيمة
}

دالة حلل_نحويا(رموز) {
    متغير موضع = ٠
    متغير الأخير = طول(رموز) - ١

    دالة الحالي() { أرجع رموز[موضع] }

    دالة انظر(إزاحة) { أرجع رموز[أدنى(موضع + إزاحة، الأخير)] }

    دالة هو(نوع_) { أرجع رموز[موضع]["نوع"] == نوع_ }

    دالة تقدم() {
        متغير ر = رموز[موضع]
        إذا (ر["نوع"] != "EOF") { موضع += ١ }
        أرجع ر
    }

    دالة طابق(نوع_) {
        إذا (هو(نوع_)) { أرجع تقدم() }
        أرجع عدم
    }

    دالة صف(ر) {
        إذا (ر["نوع"] == "EOF") { أرجع "نهاية الملف" }
        إذا (ر["نوع"] == "NEWLINE") { أرجع "نهاية السطر" }
        أرجع "«" + وصف_قيمة(ر) + "»"
    }

    دالة توقع(نوع_، وصف) {
        إذا (هو(نوع_)) { أرجع تقدم() }
        متغير المتوقع = وصف
        إذا (المتوقع == عدم) { المتوقع = أسماء_الرموز.اجلب(نوع_، نوع_) }
        خطأ_نحوي("توقّعت " + المتوقع + " ولكن وجدت " + صف(الحالي())، الحالي()["سطر"])
    }

    دالة تجاوز_الأسطر() {
        طالما (هو("NEWLINE")) { تقدم() }
    }

    دالة أنه_الجملة() {
        إذا (هو("EOF") أو هو("RBRACE")) { أرجع عدم }
        إذا (طابق("NEWLINE") != عدم) { أرجع عدم }
        خطأ_نحوي("توقّعت نهاية الجملة ولكن وجدت " + صف(الحالي())، الحالي()["سطر"])
    }

    # ——— البرنامج والكتل ———

    دالة برنامج() {
        متغير جمل = []
        تجاوز_الأسطر()
        طالما (ليس هو("EOF")) {
            جمل.أضف(جملة())
            تجاوز_الأسطر()
        }
        أرجع عقدة("برنامج"، ١، {"جمل": جمل})
    }

    دالة كتلة() {
        تجاوز_الأسطر()
        متغير قوس = توقع("LBRACE"، "«{»")
        متغير جمل = []
        تجاوز_الأسطر()
        طالما (ليس هو("RBRACE")) {
            إذا (هو("EOF")) { خطأ_نحوي("كتلة لم تُغلق بـ«}»"، قوس["سطر"]) }
            جمل.أضف(جملة())
            تجاوز_الأسطر()
        }
        توقع("RBRACE"، "«}»")
        أرجع عقدة("كتلة"، قوس["سطر"]، {"جمل": جمل})
    }

    دالة يشبه_قاموسا() {
        متغير إزاحة = ١
        طالما (انظر(إزاحة)["نوع"] == "NEWLINE") { إزاحة += ١ }
        متغير ن = انظر(إزاحة)["نوع"]
        إذا (ن != "STRING" و ن != "NUMBER" و ن != "IDENT") { أرجع خطأ }
        أرجع انظر(إزاحة + ١)["نوع"] == "COLON"
    }

    # ——— الجمل ———

    دالة جملة() {
        متغير ر = الحالي()
        متغير ن = ر["نوع"]
        إذا (ن == "VAR" أو ن == "CONST") { أرجع تصريح() }
        إذا (ن == "IF") { أرجع جملة_إذا() }
        إذا (ن == "WHILE") { أرجع جملة_طالما() }
        إذا (ن == "FOR") { أرجع جملة_لكل() }
        إذا (ن == "FUNC" و انظر(١)["نوع"] == "IDENT") { أرجع تعريف_دالة() }
        إذا (ن == "CLASS") { أرجع تعريف_صنف() }
        إذا (ن == "RETURN") { أرجع جملة_أرجع() }
        إذا (ن == "TRY") { أرجع جملة_حاول() }
        إذا (ن == "THROW") {
            تقدم()
            متغير قيمة = تعبير()
            أنه_الجملة()
            أرجع عقدة("ارمِ"، ر["سطر"]، {"قيمة": قيمة})
        }
        إذا (ن == "BREAK") {
            تقدم()
            أنه_الجملة()
            أرجع عقدة("توقف"، ر["سطر"]، {})
        }
        إذا (ن == "CONTINUE") {
            تقدم()
            أنه_الجملة()
            أرجع عقدة("استمر"، ر["سطر"]، {})
        }
        إذا (ن == "LBRACE" و ليس يشبه_قاموسا()) { أرجع كتلة() }
        أرجع جملة_تعبير()
    }

    دالة تصريح() {
        متغير ر = تقدم()
        متغير اسم = توقع("IDENT"، "اسم متغير")["قيمة"]
        متغير قيمة = عدم
        إذا (طابق("ASSIGN") != عدم) {
            تجاوز_الأسطر()
            قيمة = تعبير()
        } وإلا إذا (ر["نوع"] == "CONST") {
            خطأ_نحوي("الثابت «" + اسم + "» يجب أن تُسند إليه قيمة"، ر["سطر"])
        }
        أنه_الجملة()
        أرجع عقدة("تصريح"، ر["سطر"]، {"اسم": اسم، "قيمة": قيمة، "مثبت": ر["نوع"] == "CONST"})
    }

    دالة جملة_إذا() {
        متغير ر = تقدم()
        متغير شرط_ = شرط()
        متغير ثم = كتلة()
        متغير بديل = عدم
        متغير محفوظ = موضع
        تجاوز_الأسطر()
        إذا (طابق("ELSE") != عدم) {
            إذا (هو("IF")) { بديل = جملة_إذا() } وإلا { بديل = كتلة() }
        } وإلا {
            موضع = محفوظ
        }
        أرجع عقدة("إذا"، ر["سطر"]، {"شرط": شرط_، "ثم": ثم، "بديل": بديل})
    }

    دالة جملة_طالما() {
        متغير ر = تقدم()
        متغير شرط_ = شرط()
        متغير جسم = كتلة()
        أرجع عقدة("طالما"، ر["سطر"]، {"شرط": شرط_، "جسم": جسم})
    }

    دالة جملة_لكل() {
        متغير ر = تقدم()
        متغير بقوس = طابق("LPAREN") != عدم
        متغير اسم = توقع("IDENT"، "اسم متغير الحلقة")["قيمة"]
        توقع("IN"، "«في»")
        متغير مكرر = تعبير()
        إذا (بقوس) { توقع("RPAREN"، "«)»") }
        متغير جسم = كتلة()
        أرجع عقدة("لكل"، ر["سطر"]، {"اسم": اسم، "مكرر": مكرر، "جسم": جسم})
    }

    دالة شرط() {
        إذا (طابق("LPAREN") != عدم) {
            تجاوز_الأسطر()
            متغير ت = تعبير()
            تجاوز_الأسطر()
            توقع("RPAREN"، "«)»")
            أرجع ت
        }
        أرجع تعبير()
    }

    دالة معاملات() {
        توقع("LPAREN"، "«(»")
        متغير قائمة_ = []
        تجاوز_الأسطر()
        إذا (ليس هو("RPAREN")) {
            طالما (صحيح) {
                تجاوز_الأسطر()
                متغير اسم = توقع("IDENT"، "اسم وسيط")["قيمة"]
                متغير افتراضي = عدم
                إذا (طابق("ASSIGN") != عدم) { افتراضي = تعبير() }
                قائمة_.أضف([اسم، افتراضي])
                تجاوز_الأسطر()
                إذا (طابق("COMMA") == عدم) { توقف }
            }
        }
        تجاوز_الأسطر()
        توقع("RPAREN"، "«)»")
        أرجع قائمة_
    }

    دالة تعريف_دالة() {
        متغير ر = تقدم()
        متغير اسم = توقع("IDENT"، "اسم الدالة")["قيمة"]
        متغير وسائط_ = معاملات()
        متغير جسم = كتلة()
        أرجع عقدة("تعريف_دالة"، ر["سطر"]، {"اسم": اسم، "وسائط": وسائط_، "جسم": جسم})
    }

    دالة تعريف_صنف() {
        متغير ر = تقدم()
        متغير اسم = توقع("IDENT"، "اسم الصنف")["قيمة"]
        متغير أب = عدم
        إذا (طابق("EXTENDS") != عدم) { أب = توقع("IDENT"، "اسم الصنف الأب")["قيمة"] }
        تجاوز_الأسطر()
        متغير قوس = توقع("LBRACE"، "«{»")
        متغير توابع = []
        تجاوز_الأسطر()
        طالما (ليس هو("RBRACE")) {
            إذا (هو("EOF")) { خطأ_نحوي("جسم الصنف لم يُغلق بـ«}»"، قوس["سطر"]) }
            طابق("FUNC")
            متغير رمز_التابع = الحالي()
            متغير اسم_التابع = توقع("IDENT"، "اسم تابع")["قيمة"]
            متغير وسائط_ = معاملات()
            متغير جسم = كتلة()
            توابع.أضف(عقدة("تعريف_دالة"، رمز_التابع["سطر"]،
                           {"اسم": اسم_التابع، "وسائط": وسائط_، "جسم": جسم}))
            تجاوز_الأسطر()
        }
        توقع("RBRACE"، "«}»")
        أرجع عقدة("تعريف_صنف"، ر["سطر"]، {"اسم": اسم، "أب": أب، "توابع": توابع})
    }

    دالة جملة_أرجع() {
        متغير ر = تقدم()
        متغير قيمة = عدم
        إذا (ليس (هو("NEWLINE") أو هو("RBRACE") أو هو("EOF"))) { قيمة = تعبير() }
        أنه_الجملة()
        أرجع عقدة("أرجع"، ر["سطر"]، {"قيمة": قيمة})
    }

    دالة جملة_حاول() {
        متغير ر = تقدم()
        متغير جسم = كتلة()
        متغير اسم_الخطأ = عدم
        متغير معالج = عدم
        متغير ختام = عدم
        متغير محفوظ = موضع
        تجاوز_الأسطر()
        إذا (طابق("CATCH") != عدم) {
            إذا (طابق("LPAREN") != عدم) {
                اسم_الخطأ = توقع("IDENT"، "اسم متغير الخطأ")["قيمة"]
                توقع("RPAREN"، "«)»")
            } وإلا إذا (هو("IDENT")) {
                اسم_الخطأ = تقدم()["قيمة"]
            }
            معالج = كتلة()
            محفوظ = موضع
            تجاوز_الأسطر()
        }
        إذا (طابق("FINALLY") != عدم) {
            ختام = كتلة()
        } وإلا {
            موضع = محفوظ
        }
        إذا (معالج == عدم و ختام == عدم) {
            خطأ_نحوي("«حاول» يحتاج إلى «امسك» أو «أخيرًا»"، ر["سطر"])
        }
        أرجع عقدة("حاول"، ر["سطر"]، {"جسم": جسم، "اسم_الخطأ": اسم_الخطأ، "معالج": معالج، "ختام": ختام})
    }

    دالة جملة_تعبير() {
        متغير ر = الحالي()
        متغير هدف = تعبير()
        متغير عملية = الحالي()
        إذا (عملية["نوع"] في عمليات_الإسناد) {
            تقدم()
            تجاوز_الأسطر()
            متغير قيمة = تعبير()
            متغير ن = هدف["نوع"]
            إذا (ن != "اسم" و ن != "فهرس" و ن != "عضو") {
                خطأ_نحوي("لا يمكن الإسناد إلى هذا التعبير"، عملية["سطر"])
            }
            أنه_الجملة()
            أرجع عقدة("إسناد"، عملية["سطر"]،
                       {"هدف": هدف، "عملية": عمليات_الإسناد[عملية["نوع"]]، "قيمة": قيمة})
        }
        أنه_الجملة()
        أرجع عقدة("جملة_تعبير"، ر["سطر"]، {"تعبير": هدف})
    }

    # ——— التعابير، من الأضعف إلى الأقوى ———

    دالة تعبير() { أرجع أو_() }

    دالة أو_() {
        متغير ت = و_()
        طالما (هو("OR")) {
            متغير ر = تقدم()
            تجاوز_الأسطر()
            ت = عقدة("منطقي"، ر["سطر"]، {"عملية": "أو"، "يسار": ت، "يمين": و_()})
        }
        أرجع ت
    }

    دالة و_() {
        متغير ت = مساواة()
        طالما (هو("AND")) {
            متغير ر = تقدم()
            تجاوز_الأسطر()
            ت = عقدة("منطقي"، ر["سطر"]، {"عملية": "و"، "يسار": ت، "يمين": مساواة()})
        }
        أرجع ت
    }

    دالة ثنائي(ت، ر، يمين) {
        أرجع عقدة("ثنائي"، ر["سطر"]، {"عملية": ر["عملية"]، "يسار": ت، "يمين": يمين})
    }

    دالة مساواة() {
        متغير ت = مقارنة()
        طالما (الحالي()["نوع"] في عمليات_المساواة) {
            متغير ر = تقدم()
            ت = عقدة("ثنائي"، ر["سطر"]، {"عملية": عمليات_المساواة[ر["نوع"]]، "يسار": ت، "يمين": مقارنة()})
        }
        أرجع ت
    }

    دالة مقارنة() {
        متغير ت = جمع()
        طالما (الحالي()["نوع"] في عمليات_المقارنة) {
            متغير ر = تقدم()
            ت = عقدة("ثنائي"، ر["سطر"]، {"عملية": عمليات_المقارنة[ر["نوع"]]، "يسار": ت، "يمين": جمع()})
        }
        أرجع ت
    }

    دالة جمع() {
        متغير ت = ضرب()
        طالما (الحالي()["نوع"] في عمليات_الجمع) {
            متغير ر = تقدم()
            ت = عقدة("ثنائي"، ر["سطر"]، {"عملية": عمليات_الجمع[ر["نوع"]]، "يسار": ت، "يمين": ضرب()})
        }
        أرجع ت
    }

    دالة ضرب() {
        متغير ت = أحادي()
        طالما (الحالي()["نوع"] في عمليات_الضرب) {
            متغير ر = تقدم()
            ت = عقدة("ثنائي"، ر["سطر"]، {"عملية": عمليات_الضرب[ر["نوع"]]، "يسار": ت، "يمين": أحادي()})
        }
        أرجع ت
    }

    دالة أحادي() {
        إذا (هو("NOT") أو هو("MINUS") أو هو("PLUS")) {
            متغير ر = تقدم()
            متغير عملية = "+"
            إذا (ر["نوع"] == "NOT") { عملية = "ليس" }
            وإلا إذا (ر["نوع"] == "MINUS") { عملية = "-" }
            أرجع عقدة("أحادي"، ر["سطر"]، {"عملية": عملية، "معامل": أحادي()})
        }
        أرجع أس()
    }

    دالة أس() {
        متغير ت = لاحقة()
        إذا (هو("POW")) {
            متغير ر = تقدم()
            أرجع عقدة("ثنائي"، ر["سطر"]، {"عملية": "**"، "يسار": ت، "يمين": أحادي()})
        }
        أرجع ت
    }

    دالة لاحقة() {
        متغير ت = أولي()
        طالما (صحيح) {
            إذا (هو("LPAREN")) {
                متغير ر = تقدم()
                ت = عقدة("نداء"، ر["سطر"]، {"منادى": ت، "وسائط": مدخلات_النداء()})
            } وإلا إذا (هو("LBRACKET")) {
                متغير ر = تقدم()
                تجاوز_الأسطر()
                متغير بداية = عدم
                إذا (ليس هو("COLON")) { بداية = تعبير() }
                إذا (طابق("COLON") != عدم) {
                    متغير نهاية_ = عدم
                    إذا (ليس هو("RBRACKET")) { نهاية_ = تعبير() }
                    ت = عقدة("تقطيع"، ر["سطر"]، {"كائن": ت، "بداية": بداية، "نهاية": نهاية_})
                } وإلا {
                    ت = عقدة("فهرس"، ر["سطر"]، {"كائن": ت، "مفتاح": بداية})
                }
                تجاوز_الأسطر()
                توقع("RBRACKET"، "«]»")
            } وإلا إذا (هو("DOT")) {
                متغير ر = تقدم()
                متغير اسم = توقع("IDENT"، "اسم عضو")["قيمة"]
                ت = عقدة("عضو"، ر["سطر"]، {"كائن": ت، "اسم": اسم})
            } وإلا {
                أرجع ت
            }
        }
    }

    دالة مدخلات_النداء() {
        متغير قائمة_ = []
        تجاوز_الأسطر()
        إذا (ليس هو("RPAREN")) {
            طالما (صحيح) {
                تجاوز_الأسطر()
                قائمة_.أضف(تعبير())
                تجاوز_الأسطر()
                إذا (طابق("COMMA") == عدم) { توقف }
            }
        }
        تجاوز_الأسطر()
        توقع("RPAREN"، "«)»")
        أرجع قائمة_
    }

    دالة أولي() {
        متغير ر = الحالي()
        متغير ن = ر["نوع"]
        إذا (ن == "NUMBER" أو ن == "STRING") {
            تقدم()
            أرجع عقدة("حرفي"، ر["سطر"]، {"قيمة": ر["قيمة"]، "عشري": ر["عشري"]})
        }
        إذا (ن == "TRUE") { تقدم()؛ أرجع عقدة("حرفي"، ر["سطر"]، {"قيمة": صحيح}) }
        إذا (ن == "FALSE") { تقدم()؛ أرجع عقدة("حرفي"، ر["سطر"]، {"قيمة": خطأ}) }
        إذا (ن == "NULL") { تقدم()؛ أرجع عقدة("حرفي"، ر["سطر"]، {"قيمة": عدم}) }
        إذا (ن == "IDENT") { تقدم()؛ أرجع عقدة("اسم"، ر["سطر"]، {"اسم": ر["قيمة"]}) }
        إذا (ن == "THIS") { تقدم()؛ أرجع عقدة("هذا"، ر["سطر"]، {}) }
        إذا (ن == "SUPER") { تقدم()؛ أرجع عقدة("الأصل"، ر["سطر"]، {}) }
        إذا (ن == "FUNC") {
            تقدم()
            متغير اسم = عدم
            إذا (هو("IDENT")) { اسم = تقدم()["قيمة"] }
            متغير وسائط_ = معاملات()
            متغير جسم = كتلة()
            أرجع عقدة("دالة"، ر["سطر"]، {"اسم": اسم، "وسائط": وسائط_، "جسم": جسم})
        }
        إذا (ن == "LPAREN") {
            تقدم()
            تجاوز_الأسطر()
            متغير ت = تعبير()
            تجاوز_الأسطر()
            توقع("RPAREN"، "«)»")
            أرجع ت
        }
        إذا (ن == "LBRACKET") {
            تقدم()
            متغير عناصر = []
            تجاوز_الأسطر()
            إذا (ليس هو("RBRACKET")) {
                طالما (صحيح) {
                    تجاوز_الأسطر()
                    إذا (هو("RBRACKET")) { توقف }
                    عناصر.أضف(تعبير())
                    تجاوز_الأسطر()
                    إذا (طابق("COMMA") == عدم) { توقف }
                }
            }
            تجاوز_الأسطر()
            توقع("RBRACKET"، "«]»")
            أرجع عقدة("قائمة"، ر["سطر"]، {"عناصر": عناصر})
        }
        إذا (ن == "LBRACE") {
            تقدم()
            متغير أزواج = []
            تجاوز_الأسطر()
            إذا (ليس هو("RBRACE")) {
                طالما (صحيح) {
                    تجاوز_الأسطر()
                    إذا (هو("RBRACE")) { توقف }
                    متغير مفتاح = تعبير()
                    توقع("COLON"، "«:»")
                    تجاوز_الأسطر()
                    أزواج.أضف([مفتاح، تعبير()])
                    تجاوز_الأسطر()
                    إذا (طابق("COMMA") == عدم) { توقف }
                }
            }
            تجاوز_الأسطر()
            توقع("RBRACE"، "«}»")
            أرجع عقدة("قاموس"، ر["سطر"]، {"أزواج": أزواج})
        }
        خطأ_نحوي("تعبير غير متوقّع: " + صف(ر)، ر["سطر"])
    }

    أرجع برنامج()
}


# ═══════════════════════════ القيم ═══════════════════════════

دالة هوية_جديدة() {
    عداد_الهويات += ١
    أرجع عداد_الهويات
}

# نوع قيمة «نون» الداخلية («دالة»، «مربوط»، «صنف»، «كائن»، «الأصل»)، أو عدم
دالة نوع_نون(قيمة) {
    إذا (نوع(قيمة) == "قاموس" و علامة في قيمة) { أرجع قيمة[علامة] }
    أرجع عدم
}

دالة اسم_النوع(قيمة) {
    متغير ن = نوع_نون(قيمة)
    إذا (ن == عدم) { أرجع نوع(قيمة) }
    إذا (ن == "دالة" أو ن == "مربوط") { أرجع "دالة" }
    إذا (ن == "صنف") { أرجع "صنف" }
    إذا (ن == "كائن") { أرجع قيمة["صنف"]["اسم"] }
    أرجع "غير معروف"
}

دالة دالة_نون(اسم، وسائط_، جسم، إغلاق، تابع_) {
    متغير الاسم = اسم
    إذا (الاسم == عدم) { الاسم = "دالة مجهولة" }
    أرجع {علامة: "دالة"، "اسم": الاسم، "وسائط": وسائط_، "جسم": جسم، "إغلاق": إغلاق،
           "تابع": تابع_، "هوية": هوية_جديدة()}
}

دالة اربط(دالة_، كائن، مالك) {
    أرجع {علامة: "مربوط"، "دالة": دالة_، "كائن": كائن، "صنف": مالك، "هوية": هوية_جديدة()}
}

دالة ابحث_عن_تابع(صنف_، اسم) {
    متغير ص = صنف_
    طالما (ص != عدم) {
        إذا (اسم في ص["توابع"]) { أرجع [ص، ص["توابع"][اسم]] }
        ص = ص["أب"]
    }
    أرجع عدم
}

# ——— العرض: values.stringify ثم Runtime.stringify ———

دالة نص_بسيط(قيمة، مقتبس) {
    متغير ن = نوع_نون(قيمة)
    إذا (ن != عدم) {
        إذا (ن == "دالة") { أرجع "<دالة " + قيمة["اسم"] + ">" }
        إذا (ن == "مربوط") { أرجع "<تابع " + قيمة["دالة"]["اسم"] + ">" }
        إذا (ن == "صنف") { أرجع "<صنف " + قيمة["اسم"] + ">" }
        إذا (ن == "كائن") { أرجع "<كائن " + قيمة["صنف"]["اسم"] + ">" }
        أرجع "<الأصل>"
    }
    متغير ت = نوع(قيمة)
    إذا (ت == "نص") {
        إذا (مقتبس) { أرجع تنصيص + قيمة + تنصيص }
        أرجع قيمة
    }
    إذا (ت == "قائمة") {
        متغير أجزاء = []
        لكل ع في قيمة { أجزاء.أضف(نص_بسيط(ع، صحيح)) }
        أرجع "[" + أجزاء.وصل("، ") + "]"
    }
    إذا (ت == "قاموس") {
        متغير أجزاء = []
        لكل م في قيمة { أجزاء.أضف(نص_بسيط(م، صحيح) + ": " + نص_بسيط(قيمة[م]، صحيح)) }
        أرجع "{" + أجزاء.وصل("، ") + "}"
    }
    أرجع نص(قيمة)
}

دالة مقتبس_(قيمة) {
    إذا (نوع(قيمة) == "نص") { أرجع تنصيص + قيمة + تنصيص }
    أرجع نص_قيمة(قيمة)
}

دالة نص_قيمة(قيمة) {
    متغير ن = نوع_نون(قيمة)
    إذا (ن == "كائن") {
        متغير وجد = ابحث_عن_تابع(قيمة["صنف"]، "نص")
        إذا (وجد != عدم) {
            أرجع نص_بسيط(استدع(اربط(وجد[١]، قيمة، وجد[٠])، []، السطر_الحالي)، خطأ)
        }
    }
    إذا (ن == عدم) {
        متغير ت = نوع(قيمة)
        إذا (ت == "قائمة") {
            متغير أجزاء = []
            لكل ع في قيمة { أجزاء.أضف(مقتبس_(ع)) }
            أرجع "[" + أجزاء.وصل("، ") + "]"
        }
        إذا (ت == "قاموس") {
            متغير أجزاء = []
            لكل م في قيمة { أجزاء.أضف(مقتبس_(م) + ": " + مقتبس_(قيمة[م])) }
            أرجع "{" + أجزاء.وصل("، ") + "}"
        }
    }
    أرجع نص_بسيط(قيمة، خطأ)
}

# ——— المساواة: values.equals، وكائنات «نون» تتساوى بهويّتها فقط ———

دالة يساوي(أ، ب) {
    متغير ن_أ = نوع_نون(أ)
    متغير ن_ب = نوع_نون(ب)
    إذا (ن_أ != عدم أو ن_ب != عدم) {
        أرجع ن_أ != عدم و ن_ب != عدم و أ["هوية"] == ب["هوية"]
    }
    متغير ت_أ = نوع(أ)
    متغير ت_ب = نوع(ب)
    إذا (ت_أ == "قائمة" و ت_ب == "قائمة") {
        إذا (طول(أ) != طول(ب)) { أرجع خطأ }
        لكل ي في مدى(طول(أ)) {
            إذا (ليس يساوي(أ[ي]، ب[ي])) { أرجع خطأ }
        }
        أرجع صحيح
    }
    إذا (ت_أ == "قاموس" و ت_ب == "قاموس") {
        إذا (طول(أ) != طول(ب)) { أرجع خطأ }
        لكل م في أ {
            إذا (ليس (م في ب) أو ليس يساوي(أ[م]، ب[م])) { أرجع خطأ }
        }
        أرجع صحيح
    }
    أرجع أ == ب
}

دالة فيها_نون(قيم_) {
    لكل ق في قيم_ {
        إذا (نوع_نون(ق) != عدم) { أرجع صحيح }
    }
    أرجع خطأ
}


# ═══════════════════════════ البيئات ═══════════════════════════

دالة بيئة_جديدة(أب) {
    أرجع {"متغيرات": {}، "ثوابت": {}، "أب": أب}
}

دالة صرح(ب، اسم، قيمة، مثبت) {
    ب["متغيرات"][اسم] = قيمة
    إذا (مثبت) {
        ب["ثوابت"][اسم] = صحيح
    } وإلا إذا (اسم في ب["ثوابت"]) {
        ب["ثوابت"].احذف(اسم)
    }
}

دالة اجلب_متغيرا(ب، اسم، سطر) {
    متغير ح = ب
    طالما (ح != عدم) {
        متغير متغيرات = ح["متغيرات"]
        إذا (اسم في متغيرات) { أرجع متغيرات[اسم] }
        ح = ح["أب"]
    }
    خطأ_تشغيل("المتغيّر «" + اسم + "» غير مُعرَّف"، سطر)
}

دالة معرف(ب، اسم) {
    متغير ح = ب
    طالما (ح != عدم) {
        إذا (اسم في ح["متغيرات"]) { أرجع صحيح }
        ح = ح["أب"]
    }
    أرجع خطأ
}

دالة أسند_متغيرا(ب، اسم، قيمة، سطر) {
    متغير ح = ب
    طالما (ح != عدم) {
        إذا (اسم في ح["متغيرات"]) {
            إذا (اسم في ح["ثوابت"]) {
                خطأ_تشغيل("«" + اسم + "» ثابت، لا يمكن تغيير قيمته"، سطر)
            }
            ح["متغيرات"][اسم] = قيمة
            أرجع عدم
        }
        ح = ح["أب"]
    }
    خطأ_تشغيل("المتغيّر «" + اسم + "» غير مُعرَّف؛ استعمل «متغير " + اسم + " = ...» أوّلًا"، سطر)
}


# ═══════════════════════════ العمليات على القيم ═══════════════════════════

دالة يحوي(حاوية، عنصر، سطر) {
    إذا (نوع_نون(حاوية) != عدم) {
        خطأ_تشغيل("لا يمكن البحث داخل قيمة من نوع «" + اسم_النوع(حاوية) + "»"، سطر)
    }
    متغير ت = نوع(حاوية)
    إذا (ت == "قائمة") {
        لكل ع في حاوية {
            إذا (يساوي(ع، عنصر)) { أرجع صحيح }
        }
        أرجع خطأ
    }
    إذا (ت == "قاموس" و نوع_نون(عنصر) != عدم) { أرجع خطأ }
    السطر_الحالي = سطر
    أرجع عنصر في حاوية
}

دالة عملية_ثنائية(عملية، يسار، يمين، سطر) {
    إذا (عملية == "==") { أرجع يساوي(يسار، يمين) }
    إذا (عملية == "!=") { أرجع ليس يساوي(يسار، يمين) }
    إذا (عملية == "في") { أرجع يحوي(يمين، يسار، سطر) }

    # ضمّ نصّ إلى أي قيمة: تُعرض الأخرى كما تُطبع، ومنها كائنات «نون»
    إذا (عملية == "+" و (نوع(يسار) == "نص" أو نوع(يمين) == "نص")) {
        أرجع نص_قيمة(يسار) + نص_قيمة(يمين)
    }

    إذا (نوع_نون(يسار) != عدم أو نوع_نون(يمين) != عدم) {
        متغير أ = اسم_النوع(يسار)
        متغير ب = اسم_النوع(يمين)
        إذا (عملية == "<" أو عملية == ">" أو عملية == "<=" أو عملية == ">=") {
            خطأ_تشغيل("لا يمكن المقارنة بين «" + أ + "» و«" + ب + "»"، سطر)
        }
        إذا (عملية == "+") { خطأ_تشغيل("لا يمكن جمع «" + أ + "» مع «" + ب + "»"، سطر) }
        إذا (عملية == "*") { خطأ_تشغيل("لا يمكن ضرب «" + أ + "» في «" + ب + "»"، سطر) }
        خطأ_تشغيل("العملية «" + عملية + "» تحتاج عددين، لا «" + أ + "» و«" + ب + "»"، سطر)
    }

    السطر_الحالي = سطر
    إذا (عملية == "+") { أرجع يسار + يمين }
    إذا (عملية == "-") { أرجع يسار - يمين }
    إذا (عملية == "*") { أرجع يسار * يمين }
    إذا (عملية == "<") { أرجع يسار < يمين }
    إذا (عملية == ">") { أرجع يسار > يمين }
    إذا (عملية == "<=") { أرجع يسار <= يمين }
    إذا (عملية == ">=") { أرجع يسار >= يمين }
    إذا (عملية == "/") { أرجع يسار / يمين }
    إذا (عملية == "//") { أرجع يسار // يمين }
    إذا (عملية == "%") { أرجع يسار % يمين }
    أرجع يسار ** يمين
}

دالة عملية_أحادية(عملية، قيمة، سطر) {
    إذا (عملية == "ليس") { أرجع ليس منطقي(قيمة) }
    إذا (نوع_نون(قيمة) != عدم) {
        إذا (عملية == "-") {
            خطأ_تشغيل("لا يمكن نفي قيمة من نوع «" + اسم_النوع(قيمة) + "»"، سطر)
        }
        خطأ_تشغيل("«+» الأحادية تحتاج عددًا، لا «" + اسم_النوع(قيمة) + "»"، سطر)
    }
    السطر_الحالي = سطر
    إذا (عملية == "-") { أرجع -قيمة }
    أرجع +قيمة
}

دالة اجلب_من_كائن(كائن، اسم، سطر) {
    إذا (اسم في كائن["حقول"]) { أرجع كائن["حقول"][اسم] }
    متغير وجد = ابحث_عن_تابع(كائن["صنف"]، اسم)
    إذا (وجد != عدم) { أرجع اربط(وجد[١]، كائن، وجد[٠]) }
    خطأ_تشغيل("الكائن من الصنف «" + كائن["صنف"]["اسم"] + "» لا يملك «" + اسم + "»"، سطر)
}

دالة اجلب_عضوا(كائن، اسم، سطر) {
    متغير ن = نوع_نون(كائن)
    إذا (ن == "كائن") { أرجع اجلب_من_كائن(كائن، اسم، سطر) }
    إذا (ن == "الأصل") {
        متغير وجد = ابحث_عن_تابع(كائن["أب"]، اسم)
        إذا (وجد == عدم) {
            خطأ_تشغيل("الصنف الأب «" + كائن["أب"]["اسم"] + "» لا يملك التابع «" + اسم + "»"، سطر)
        }
        أرجع اربط(وجد[١]، كائن["كائن"]، وجد[٠])
    }
    إذا (ن == "صنف") {
        متغير وجد = ابحث_عن_تابع(كائن، اسم)
        إذا (وجد == عدم) { خطأ_تشغيل("الصنف «" + كائن["اسم"] + "» لا يملك «" + اسم + "»"، سطر) }
        أرجع وجد[١]
    }
    إذا (ن != عدم) {
        خطأ_تشغيل("لا يمكن قراءة «" + اسم + "» من قيمة من نوع «" + اسم_النوع(كائن) + "»"، سطر)
    }
    السطر_الحالي = سطر
    أرجع عضو(كائن، اسم)
}

دالة ضع_عضوا(كائن، اسم، قيمة، سطر) {
    متغير ن = نوع_نون(كائن)
    إذا (ن == "كائن") {
        كائن["حقول"][اسم] = قيمة
    } وإلا إذا (ن == عدم و نوع(كائن) == "قاموس") {
        كائن[اسم] = قيمة
    } وإلا {
        خطأ_تشغيل("لا يمكن إسناد عضو إلى قيمة من نوع «" + اسم_النوع(كائن) + "»"، سطر)
    }
}

دالة اجلب_بفهرس(كائن، مفتاح، سطر) {
    متغير ن = نوع_نون(كائن)
    إذا (ن == "كائن") { أرجع اجلب_من_كائن(كائن، نص_قيمة(مفتاح)، سطر) }
    إذا (ن != عدم) {
        خطأ_تشغيل("لا يمكن فهرسة قيمة من نوع «" + اسم_النوع(كائن) + "»"، سطر)
    }
    إذا (نوع(كائن) == "قاموس" و نوع_نون(مفتاح) != عدم) {
        خطأ_تشغيل("المفتاح «" + نص_بسيط(مفتاح، خطأ) + "» غير موجود في القاموس"، سطر)
    }
    السطر_الحالي = سطر
    أرجع كائن[مفتاح]
}

دالة ضع_بفهرس(كائن، مفتاح، قيمة، سطر) {
    متغير ن = نوع_نون(كائن)
    إذا (ن == "كائن") {
        كائن["حقول"][نص_قيمة(مفتاح)] = قيمة
        أرجع عدم
    }
    إذا (ن != عدم) {
        خطأ_تشغيل("لا يمكن الإسناد داخل قيمة من نوع «" + اسم_النوع(كائن) + "»"، سطر)
    }
    إذا (نوع(كائن) == "قاموس" و نوع_نون(مفتاح) != عدم) {
        خطأ_تشغيل("مفتاح القاموس يجب أن يكون نصًّا أو عددًا"، سطر)
    }
    السطر_الحالي = سطر
    كائن[مفتاح] = قيمة
}

دالة عناصر_التكرار(قيمة، سطر) {
    إذا (نوع_نون(قيمة) != عدم) {
        خطأ_تشغيل("لا يمكن التكرار على قيمة من نوع «" + اسم_النوع(قيمة) + "»"، سطر)
    }
    السطر_الحالي = سطر
    أرجع قائمة(قيمة)
}


# ═══════════════════════════ الاستدعاء ═══════════════════════════

دالة تحقق_العدد(اسم، مدخلات، أدنى_، أقصى_، سطر) {
    متغير ن = طول(مدخلات)
    إذا (ن < أدنى_ أو (أقصى_ >= ٠ و ن > أقصى_)) {
        متغير متوقع = رقم_لاتيني(أدنى_)
        إذا (أدنى_ != أقصى_) {
            متغير حد = "∞"
            إذا (أقصى_ >= ٠) { حد = رقم_لاتيني(أقصى_) }
            متوقع = رقم_لاتيني(أدنى_) + ".." + حد
        }
        خطأ_تشغيل("الدالة «" + اسم + "» تتوقّع " + متوقع + " وسيطًا، ووصلها " + رقم_لاتيني(ن)، سطر)
    }
}

دالة استدع(منادى، مدخلات، سطر) {
    متغير ن = نوع_نون(منادى)
    إذا (ن == "دالة") { أرجع شغل_دالة(منادى، مدخلات، سطر، عدم) }
    إذا (ن == "مربوط") { أرجع شغل_دالة(منادى["دالة"]، مدخلات، سطر، منادى) }
    إذا (ن == "صنف") {
        متغير كائن = {علامة: "كائن"، "صنف": منادى، "حقول": {}، "هوية": هوية_جديدة()}
        متغير وجد = ابحث_عن_تابع(منادى، "تهيئة")
        إذا (وجد != عدم) {
            شغل_دالة(وجد[١]، مدخلات، سطر، اربط(وجد[١]، كائن، وجد[٠]))
        } وإلا إذا (طول(مدخلات) > ٠) {
            خطأ_تشغيل("الصنف «" + منادى["اسم"] + "» لا يملك تابع «تهيئة»، فلا يقبل وسائط"، سطر)
        }
        أرجع كائن
    }
    إذا (ن != عدم أو نوع(منادى) != "دالة") {
        خطأ_تشغيل("لا يمكن استدعاء قيمة من نوع «" + اسم_النوع(منادى) + "»"، سطر)
    }
    أرجع استدع_مضيفا(منادى، مدخلات، سطر)
}

دالة شغل_دالة(دالة_، مدخلات، سطر، مربوط) {
    متغير معاملات = دالة_["وسائط"]
    متغير مطلوب = ٠
    لكل معامل في معاملات {
        إذا (معامل[١] == عدم) { مطلوب += ١ }
    }
    متغير عدد_ = طول(مدخلات)
    إذا (عدد_ < مطلوب أو عدد_ > طول(معاملات)) {
        متغير متوقع = رقم_لاتيني(مطلوب)
        إذا (مطلوب != طول(معاملات)) {
            متوقع = رقم_لاتيني(مطلوب) + ".." + رقم_لاتيني(طول(معاملات))
        }
        خطأ_تشغيل("الدالة «" + دالة_["اسم"] + "» تتوقّع " + متوقع + " وسيطًا، ووصلها " + رقم_لاتيني(عدد_)، سطر)
    }

    متغير إغلاق = دالة_["إغلاق"]
    إذا (مربوط != عدم) {
        إغلاق = بيئة_جديدة(إغلاق)
        صرح(إغلاق، "هذا"، مربوط["كائن"]، خطأ)
        متغير مالك = مربوط["صنف"]
        إذا (مالك != عدم و مالك["أب"] != عدم) {
            صرح(إغلاق، "الأصل"، {علامة: "الأصل"، "كائن": مربوط["كائن"]، "أب": مالك["أب"]،
                                  "هوية": هوية_جديدة()}، خطأ)
        }
    }

    متغير ب = بيئة_جديدة(إغلاق)
    لكل ي في مدى(طول(معاملات)) {
        إذا (ي < عدد_) {
            صرح(ب، معاملات[ي][٠]، مدخلات[ي]، خطأ)
        } وإلا {
            صرح(ب، معاملات[ي][٠]، قيم(معاملات[ي][١]، ب)، خطأ)
        }
    }

    متغير إشارة = عدم
    حاول {
        إشارة = شغل_جملا(دالة_["جسم"]["جمل"]، ب)
    } امسك (خ) {
        متغير خطأ_ = طبع_خطأ(خ)
        # تجاوز عمق المضيف يُعاد بصيغة المُفسِّر الأصلي: باسم دالة البرنامج لا دوالّ هذا الملف
        إذا (نوع(خطأ_) == "قاموس" و "مضيف" في خطأ_
                و خطأ_[علامة_خطأ].يبدأ("تجاوز عمق الاستدعاء")) {
            خطأ_تشغيل("تجاوز عمق الاستدعاء (تعاود لا ينتهي؟) في «" + دالة_["اسم"] + "»"، سطر)
        }
        ارمِ خطأ_
    }

    إذا (إشارة == عدم) { أرجع عدم }
    إذا (إشارة["إشارة"] == "أرجع") { أرجع إشارة["قيمة"] }
    إذا (إشارة["إشارة"] == "توقف") {
        خطأ_تشغيل("«توقف» لا تُستعمل إلا داخل حلقة"، إشارة["سطر"])
    }
    خطأ_تشغيل("«استمر» لا تُستعمل إلا داخل حلقة"، إشارة["سطر"])
}

دالة نادي_بعدد(د، م) {
    متغير ن = طول(م)
    إذا (ن == ٠) { أرجع د() }
    إذا (ن == ١) { أرجع د(م[٠]) }
    إذا (ن == ٢) { أرجع د(م[٠]، م[١]) }
    إذا (ن == ٣) { أرجع د(م[٠]، م[١]، م[٢]) }
    إذا (ن == ٤) { أرجع د(م[٠]، م[١]، م[٢]، م[٣]) }
    إذا (ن == ٥) { أرجع د(م[٠]، م[١]، م[٢]، م[٣]، م[٤]) }
    إذا (ن == ٦) { أرجع د(م[٠]، م[١]، م[٢]، م[٣]، م[٤]، م[٥]) }
    إذا (ن == ٧) { أرجع د(م[٠]، م[١]، م[٢]، م[٣]، م[٤]، م[٥]، م[٦]) }
    إذا (ن == ٨) { أرجع د(م[٠]، م[١]، م[٢]، م[٣]، م[٤]، م[٥]، م[٦]، م[٧]) }
    خطأ_تشغيل("«نون بنون» لا يمرّر أكثر من ثمانية وسائط إلى دالة مدمجة"، السطر_الحالي)
}

# فرز مستقرّ بالدمج، كفرز بايثون، يقارن بعمليات «نون» نفسها
دالة ادمج_فرزا(أزواج، سطر) {
    إذا (طول(أزواج) <= ١) { أرجع أزواج }
    متغير وسط = طول(أزواج) // ٢
    متغير يسار = ادمج_فرزا(أزواج[:وسط]، سطر)
    متغير يمين = ادمج_فرزا(أزواج[وسط:]، سطر)
    متغير ناتج = []
    متغير أ = ٠
    متغير ب = ٠
    طالما (أ < طول(يسار) و ب < طول(يمين)) {
        إذا (عملية_ثنائية("<"، يمين[ب][٠]، يسار[أ][٠]، سطر)) {
            ناتج.أضف(يمين[ب])
            ب += ١
        } وإلا {
            ناتج.أضف(يسار[أ])
            أ += ١
        }
    }
    أرجع ناتج + يسار[أ:] + يمين[ب:]
}

دالة افرز(عناصر، مفتاح، تنازلي، سطر) {
    متغير أزواج = []
    لكل ع في عناصر {
        إذا (مفتاح == عدم) {
            أزواج.أضف([ع، ع])
        } وإلا {
            أزواج.أضف([استدع(مفتاح، [ع]، سطر)، ع])
        }
    }
    متغير ناتج = []
    لكل زوج في ادمج_فرزا(أزواج، سطر) { ناتج.أضف(زوج[١]) }
    إذا (منطقي(تنازلي)) { أرجع عكس(ناتج) }
    أرجع ناتج
}

# الدوال المدمجة تُنادى من المضيف مباشرة، إلا ما يمسّ قيم «نون» الداخلية:
# العرض والأنواع، وكل ما يُنادي دالة يمرّرها البرنامج
دالة استدع_مضيفا(د، م، سطر) {
    السطر_الحالي = سطر
    إذا (د == اطبع) {
        متغير أجزاء = []
        لكل ق في م { أجزاء.أضف(نص_قيمة(ق)) }
        اطبع(أجزاء.وصل(" "))
        أرجع عدم
    }
    إذا (د == نوع) {
        تحقق_العدد("نوع"، م، ١، ١، سطر)
        أرجع اسم_النوع(م[٠])
    }
    إذا (د == نص) {
        تحقق_العدد("نص"، م، ١، ١، سطر)
        أرجع نص_قيمة(م[٠])
    }
    إذا (فيها_نون(م)) {
        إذا (د == طول) {
            تحقق_العدد("طول"، م، ١، ١، سطر)
            خطأ_تشغيل("لا طول لقيمة من نوع «" + اسم_النوع(م[٠]) + "»"، سطر)
        }
        إذا (د == قائمة) {
            تحقق_العدد("قائمة"، م، ١، ١، سطر)
            أرجع عناصر_التكرار(م[٠]، سطر)
        }
        إذا (د == عدد) {
            تحقق_العدد("عدد"، م، ١، ١، سطر)
            خطأ_تشغيل("لا يمكن تحويل قيمة من نوع «" + اسم_النوع(م[٠]) + "» إلى عدد"، سطر)
        }
    }
    إذا (د == طبّق) {
        تحقق_العدد("طبّق"، م، ٢، ٢، سطر)
        متغير ناتج = []
        لكل ع في عناصر_التكرار(م[١]، سطر) { ناتج.أضف(استدع(م[٠]، [ع]، سطر)) }
        أرجع ناتج
    }
    إذا (د == رشّح) {
        تحقق_العدد("رشّح"، م، ٢، ٢، سطر)
        متغير ناتج = []
        لكل ع في عناصر_التكرار(م[١]، سطر) {
            إذا (منطقي(استدع(م[٠]، [ع]، سطر))) { ناتج.أضف(ع) }
        }
        أرجع ناتج
    }
    إذا (د == اختزل) {
        تحقق_العدد("اختزل"، م، ٢، ٣، سطر)
        متغير عناصر = عناصر_التكرار(م[١]، سطر)
        متغير متراكم = عدم
        متغير بقية = عناصر
        إذا (طول(م) > ٢) {
            متراكم = م[٢]
        } وإلا إذا (طول(عناصر) > ٠) {
            متراكم = عناصر[٠]
            بقية = عناصر[١:]
        } وإلا {
            خطأ_تشغيل("«اختزل» على قائمة فارغة بلا قيمة ابتدائية"، سطر)
        }
        لكل ع في بقية { متراكم = استدع(م[٠]، [متراكم، ع]، سطر) }
        أرجع متراكم
    }
    إذا (د == فرز) {
        تحقق_العدد("فرز"، م، ١، ٣، سطر)
        متغير مفتاح = عدم
        متغير تنازلي = خطأ
        إذا (طول(م) > ١) { مفتاح = م[١] }
        إذا (طول(م) > ٢) { تنازلي = م[٢] }
        أرجع افرز(عناصر_التكرار(م[٠]، سطر)، مفتاح، تنازلي، سطر)
    }
    إذا (د == متساويان) {
        تحقق_العدد("متساويان"، م، ٢، ٢، سطر)
        أرجع يساوي(م[٠]، م[١])
    }
    إذا (د == من_صنف) {
        تحقق_العدد("من_صنف"، م، ٢، ٢، سطر)
        إذا (نوع_نون(م[١]) != "صنف") {
            خطأ_تشغيل("الوسيط الثاني لـ«من_صنف» يجب أن يكون صنفًا"، سطر)
        }
        إذا (نوع_نون(م[٠]) != "كائن") { أرجع خطأ }
        متغير ص = م[٠]["صنف"]
        طالما (ص != عدم) {
            إذا (ص["هوية"] == م[١]["هوية"]) { أرجع صحيح }
            ص = ص["أب"]
        }
        أرجع خطأ
    }
    إذا (د == تحقّق) {
        تحقق_العدد("تحقّق"، م، ١، ٢، سطر)
        إذا (ليس منطقي(م[٠])) {
            متغير رسالة = "فشل التحقّق"
            إذا (طول(م) > ١) { رسالة = نص_قيمة(م[١]) }
            خطأ_تشغيل(رسالة، سطر)
        }
        أرجع عدم
    }
    إذا (د == وسائط) {
        تحقق_العدد("وسائط"، م، ٠، ٠، سطر)
        أرجع وسائط_البرنامج.نسخة()
    }
    السطر_الحالي = سطر
    أرجع نادي_بعدد(د، م)
}


# ═══════════════════════════ المُنفِّذ ═══════════════════════════

# خطأ المُفسِّر المضيف (قاموس نوع/رسالة/سطر) ← خطأ «نون» بسطر البرنامج الجاري
دالة طبع_خطأ(خ) {
    إذا (نوع(خ) == "قاموس" و "رسالة" في خ و خ.اجلب("نوع") == "خطأ تشغيل"
            و ليس (علامة_خطأ في خ) و ليس (علامة_رمية في خ) و ليس (علامة_نحوي في خ)) {
        أرجع {علامة_خطأ: خ["رسالة"]، "سطر": السطر_الحالي، "مضيف": صحيح}
    }
    أرجع خ
}

دالة قيمة_الالتقاط(خطأ_) {
    إذا (علامة_رمية في خطأ_) { أرجع خطأ_[علامة_رمية] }
    أرجع {"نوع": "خطأ تشغيل"، "رسالة": خطأ_[علامة_خطأ]، "سطر": خطأ_["سطر"]}
}

دالة شغل_جملا(جمل، ب) {
    لكل جملة_ في جمل {
        متغير إشارة = نفذ(جملة_، ب)
        إذا (إشارة != عدم) { أرجع إشارة }
    }
    أرجع عدم
}

دالة نفذ(ع، ب) {
    متغير ن = ع["نوع"]

    إذا (ن == "جملة_تعبير") {
        قيم(ع["تعبير"]، ب)
        أرجع عدم
    }
    إذا (ن == "إسناد") {
        نفذ_إسنادا(ع، ب)
        أرجع عدم
    }
    إذا (ن == "إذا") {
        إذا (منطقي(قيم(ع["شرط"]، ب))) { أرجع نفذ(ع["ثم"]، ب) }
        إذا (ع["بديل"] != عدم) { أرجع نفذ(ع["بديل"]، ب) }
        أرجع عدم
    }
    إذا (ن == "كتلة") { أرجع شغل_جملا(ع["جمل"]، بيئة_جديدة(ب)) }
    إذا (ن == "أرجع") {
        متغير قيمة = عدم
        إذا (ع["قيمة"] != عدم) { قيمة = قيم(ع["قيمة"]، ب) }
        أرجع {"إشارة": "أرجع"، "قيمة": قيمة، "سطر": ع["سطر"]}
    }
    إذا (ن == "تصريح") {
        متغير قيمة = عدم
        إذا (ع["قيمة"] != عدم) { قيمة = قيم(ع["قيمة"]، ب) }
        إذا (ع["اسم"] في ب["متغيرات"]) {
            خطأ_تشغيل("«" + ع["اسم"] + "» مُعرَّف مسبقًا في هذا النطاق"، ع["سطر"])
        }
        صرح(ب، ع["اسم"]، قيمة، ع["مثبت"])
        أرجع عدم
    }
    إذا (ن == "طالما") {
        طالما (منطقي(قيم(ع["شرط"]، ب))) {
            متغير إشارة = نفذ(ع["جسم"]، ب)
            إذا (إشارة != عدم) {
                إذا (إشارة["إشارة"] == "توقف") { توقف }
                إذا (إشارة["إشارة"] == "أرجع") { أرجع إشارة }
            }
        }
        أرجع عدم
    }
    إذا (ن == "لكل") {
        لكل عنصر في عناصر_التكرار(قيم(ع["مكرر"]، ب)، ع["سطر"]) {
            متغير بيئة = بيئة_جديدة(ب)
            صرح(بيئة، ع["اسم"]، عنصر، خطأ)
            متغير إشارة = شغل_جملا(ع["جسم"]["جمل"]، بيئة)
            إذا (إشارة != عدم) {
                إذا (إشارة["إشارة"] == "توقف") { توقف }
                إذا (إشارة["إشارة"] == "أرجع") { أرجع إشارة }
            }
        }
        أرجع عدم
    }
    إذا (ن == "تعريف_دالة") {
        صرح(ب، ع["اسم"]، دالة_نون(ع["اسم"]، ع["وسائط"]، ع["جسم"]، ب، خطأ)، خطأ)
        أرجع عدم
    }
    إذا (ن == "توقف" أو ن == "استمر") {
        أرجع {"إشارة": ن، "سطر": ع["سطر"]}
    }
    إذا (ن == "تعريف_صنف") {
        متغير أب = عدم
        إذا (ع["أب"] != عدم) {
            أب = اجلب_متغيرا(ب، ع["أب"]، ع["سطر"])
            إذا (نوع_نون(أب) != "صنف") {
                خطأ_تشغيل("«" + ع["أب"] + "» ليس صنفًا"، ع["سطر"])
            }
        }
        متغير توابع = {}
        لكل تابع في ع["توابع"] {
            توابع[تابع["اسم"]] = دالة_نون(تابع["اسم"]، تابع["وسائط"]، تابع["جسم"]، ب، صحيح)
        }
        صرح(ب، ع["اسم"]، {علامة: "صنف"، "اسم": ع["اسم"]، "أب": أب، "توابع": توابع،
                         "هوية": هوية_جديدة()}، خطأ)
        أرجع عدم
    }
    إذا (ن == "حاول") { أرجع نفذ_محاولة(ع، ب) }
    إذا (ن == "ارمِ") {
        ارمِ {علامة_رمية: قيم(ع["قيمة"]، ب)}
    }
    خطأ_تشغيل("جملة غير مدعومة: " + ن، ع["سطر"])
}

دالة نفذ_إسنادا(ع، ب) {
    متغير هدف = ع["هدف"]
    متغير قيمة = قيم(ع["قيمة"]، ب)
    إذا (ع["عملية"] != عدم) {
        قيمة = عملية_ثنائية(ع["عملية"]، قيم(هدف، ب)، قيمة، ع["سطر"])
    }
    إذا (هدف["نوع"] == "اسم") {
        أسند_متغيرا(ب، هدف["اسم"]، قيمة، ع["سطر"])
    } وإلا إذا (هدف["نوع"] == "فهرس") {
        متغير كائن = قيم(هدف["كائن"]، ب)
        متغير مفتاح = قيم(هدف["مفتاح"]، ب)
        ضع_بفهرس(كائن، مفتاح، قيمة، ع["سطر"])
    } وإلا {
        ضع_عضوا(قيم(هدف["كائن"]، ب)، هدف["اسم"]، قيمة، ع["سطر"])
    }
}

# «أخيرًا» تُنفَّذ في كل الأحوال، وإشارتها (أرجع/توقف/استمر) تُلغي الخطأ المعلَّق
دالة نفذ_محاولة(ع، ب) {
    متغير إشارة = عدم
    متغير معلق = عدم
    متغير فشل = خطأ
    حاول {
        إشارة = نفذ(ع["جسم"]، ب)
    } امسك (خ) {
        متغير خطأ_ = طبع_خطأ(خ)
        إذا (ع["معالج"] == عدم) {
            معلق = خطأ_
            فشل = صحيح
        } وإلا {
            حاول {
                متغير بيئة = بيئة_جديدة(ب)
                إذا (ع["اسم_الخطأ"] != عدم) {
                    صرح(بيئة، ع["اسم_الخطأ"]، قيمة_الالتقاط(خطأ_)، خطأ)
                }
                إشارة = شغل_جملا(ع["معالج"]["جمل"]، بيئة)
            } امسك (خ2) {
                معلق = طبع_خطأ(خ2)
                فشل = صحيح
            }
        }
    }
    إذا (ع["ختام"] != عدم) {
        متغير إشارة_الختام = نفذ(ع["ختام"]، ب)
        إذا (إشارة_الختام != عدم) { أرجع إشارة_الختام }
    }
    إذا (فشل) { ارمِ معلق }
    أرجع إشارة
}

دالة قيم(ع، ب) {
    متغير ن = ع["نوع"]

    إذا (ن == "اسم") { أرجع اجلب_متغيرا(ب، ع["اسم"]، ع["سطر"]) }
    إذا (ن == "حرفي") { أرجع ع["قيمة"] }
    إذا (ن == "ثنائي") {
        متغير يسار = قيم(ع["يسار"]، ب)
        متغير يمين = قيم(ع["يمين"]، ب)
        أرجع عملية_ثنائية(ع["عملية"]، يسار، يمين، ع["سطر"])
    }
    إذا (ن == "نداء") { أرجع قيم_نداء(ع، ب) }
    إذا (ن == "عضو") { أرجع اجلب_عضوا(قيم(ع["كائن"]، ب)، ع["اسم"]، ع["سطر"]) }
    إذا (ن == "فهرس") {
        متغير كائن = قيم(ع["كائن"]، ب)
        متغير مفتاح = قيم(ع["مفتاح"]، ب)
        أرجع اجلب_بفهرس(كائن، مفتاح، ع["سطر"])
    }
    إذا (ن == "منطقي") {
        متغير يسار = قيم(ع["يسار"]، ب)
        إذا (ع["عملية"] == "أو") {
            إذا (منطقي(يسار)) { أرجع يسار }
            أرجع قيم(ع["يمين"]، ب)
        }
        إذا (منطقي(يسار)) { أرجع قيم(ع["يمين"]، ب) }
        أرجع يسار
    }
    إذا (ن == "أحادي") { أرجع عملية_أحادية(ع["عملية"]، قيم(ع["معامل"]، ب)، ع["سطر"]) }
    إذا (ن == "قائمة") {
        متغير ناتج = []
        لكل عنصر في ع["عناصر"] { ناتج.أضف(قيم(عنصر، ب)) }
        أرجع ناتج
    }
    إذا (ن == "قاموس") {
        متغير ناتج = {}
        لكل زوج في ع["أزواج"] {
            متغير مفتاح = قيم(زوج[٠]، ب)
            متغير ت = نوع(مفتاح)
            إذا (نوع_نون(مفتاح) != عدم أو (ت != "نص" و ت != "عدد")) {
                خطأ_تشغيل("مفتاح القاموس يجب أن يكون نصًّا أو عددًا"، ع["سطر"])
            }
            ناتج[مفتاح] = قيم(زوج[١]، ب)
        }
        أرجع ناتج
    }
    إذا (ن == "دالة") { أرجع دالة_نون(ع["اسم"]، ع["وسائط"]، ع["جسم"]، ب، خطأ) }
    إذا (ن == "هذا") {
        إذا (ليس معرف(ب، "هذا")) { خطأ_تشغيل("«هذا» لا تُستعمل إلا داخل تابع"، ع["سطر"]) }
        أرجع اجلب_متغيرا(ب، "هذا"، ع["سطر"])
    }
    إذا (ن == "الأصل") {
        إذا (ليس معرف(ب، "الأصل")) {
            خطأ_تشغيل("«الأصل» لا تُستعمل إلا داخل صنف يرث صنفًا آخر"، ع["سطر"])
        }
        أرجع اجلب_متغيرا(ب، "الأصل"، ع["سطر"])
    }
    إذا (ن == "تقطيع") { أرجع قيم_تقطيعا(ع، ب) }
    خطأ_تشغيل("تعبير غير مدعوم: " + ن، ع["سطر"])
}

دالة قيم_نداء(ع، ب) {
    متغير عقدة_المنادى = ع["منادى"]
    إذا (عقدة_المنادى["نوع"] == "عضو") {
        متغير كائن = قيم(عقدة_المنادى["كائن"]، ب)
        متغير منادى = اجلب_عضوا(كائن، عقدة_المنادى["اسم"]، عقدة_المنادى["سطر"])
        متغير مدخلات = []
        لكل عقدة_ في ع["وسائط"] { مدخلات.أضف(قيم(عقدة_، ب)) }
        # قائمة.فرز(مفتاح) بدالة من البرنامج: التابع المدمج لا يستطيع مناداتها
        إذا (نوع(كائن) == "قائمة" و عقدة_المنادى["اسم"] == "فرز" و فيها_نون(مدخلات)) {
            تحقق_العدد("فرز"، [كائن] + مدخلات، ١، ٣، ع["سطر"])
            متغير مفتاح = عدم
            متغير تنازلي = خطأ
            إذا (طول(مدخلات) > ٠) { مفتاح = مدخلات[٠] }
            إذا (طول(مدخلات) > ١) { تنازلي = مدخلات[١] }
            أرجع افرز(كائن، مفتاح، تنازلي، ع["سطر"])
        }
        أرجع استدع(منادى، مدخلات، ع["سطر"])
    }
    متغير منادى = قيم(عقدة_المنادى، ب)
    متغير مدخلات = []
    لكل عقدة_ في ع["وسائط"] { مدخلات.أضف(قيم(عقدة_، ب)) }
    أرجع استدع(منادى، مدخلات، ع["سطر"])
}

دالة حد_تقطيع(عقدة_، ب، سطر) {
    إذا (عقدة_ == عدم) { أرجع عدم }
    متغير قيمة = قيم(عقدة_، ب)
    إذا (نوع(قيمة) != "عدد" أو قيمة != أرضية(قيمة)) {
        خطأ_تشغيل("حدود التقطيع يجب أن تكون أعدادًا صحيحة"، سطر)
    }
    أرجع قيمة
}

دالة قيم_تقطيعا(ع، ب) {
    متغير كائن = قيم(ع["كائن"]، ب)
    متغير ت = نوع(كائن)
    إذا (نوع_نون(كائن) != عدم أو (ت != "نص" و ت != "قائمة")) {
        خطأ_تشغيل("لا يمكن تقطيع قيمة من نوع «" + اسم_النوع(كائن) + "»"، ع["سطر"])
    }
    متغير بداية = حد_تقطيع(ع["بداية"]، ب، ع["سطر"])
    متغير نهاية_ = حد_تقطيع(ع["نهاية"]، ب، ع["سطر"])
    إذا (بداية == عدم و نهاية_ == عدم) { أرجع كائن[:] }
    إذا (نهاية_ == عدم) { أرجع كائن[بداية:] }
    إذا (بداية == عدم) { أرجع كائن[:نهاية_] }
    أرجع كائن[بداية:نهاية_]
}


# ═══════════════════════════ المترجِم ═══════════════════════════

# الشجرة النحوية ← بايت-كود تنفّذه آلة «نون» الافتراضية (noon/vm.py). نقلٌ
# لـ noon/compiler.py خطوةً خطوة، والناتج يطابقه تعليمةً تعليمة وثابتًا ثابتًا
# (tests/test_selfhost.py)؛ شرح الخوارزمية هناك: حلّ الأسماء وقت الترجمة،
# وإعادة ربط الإحالات بتعريف لاحق، وخلايا لكل دخول إلى نطاق، ونسخ «أخيرًا»
# على كل طريق خروج.
#
# الدوال والنطاقات والمحلّيات قواميس، والمساواة في «نون» عميقة، فلكلٍّ منها
# «معرف» عددي تُقارَن به الهويّة بدل المقارنة البنيوية.

# أرقام التعليمات، بترتيب noon/opcodes.py
ثابت ت_ادفع_ثابتا = ٠
ثابت ت_ادفع_محليا = ١
ثابت ت_خزن_محليا = ٢
ثابت ت_ادفع_خلية = ٣
ثابت ت_خزن_خلية = ٤
ثابت ت_هيئ_خلية = ٥
ثابت ت_ادفع_حرا = ٦
ثابت ت_خزن_حرا = ٧
ثابت ت_ادفع_عاما = ٨
ثابت ت_خزن_عاما = ٩
ثابت ت_عرف_عاما = ١٠
ثابت ت_عرف_ثابتا = ١١
ثابت ت_عرف_مستبدلا = ١٢
ثابت ت_أسقط = ١٣
ثابت ت_بادل = ١٤
ثابت ت_عملية = ١٥
ثابت ت_سالب = ١٦
ثابت ت_موجب = ١٧
ثابت ت_ليس = ١٨
ثابت ت_اقفز = ١٩
ثابت ت_اقفز_إن_كذب = ٢٠
ثابت ت_اقفز_إن_كذب_مبقيا = ٢١
ثابت ت_اقفز_إن_صدق_مبقيا = ٢٢
ثابت ت_نادِ = ٢٣
ثابت ت_أرجع = ٢٤
ثابت ت_اصنع_دالة = ٢٥
ثابت ت_ابن_قائمة = ٢٦
ثابت ت_ابن_قاموسا = ٢٧
ثابت ت_ابن_صنفا = ٢٨
ثابت ت_اجلب_بالفهرس = ٢٩
ثابت ت_ضع_بالفهرس = ٣٠
ثابت ت_اقتطع = ٣١
ثابت ت_اجلب_عضوا = ٣٢
ثابت ت_ضع_عضوا = ٣٣
ثابت ت_الأصل = ٣٤
ثابت ت_ابدأ_التكرار = ٣٥
ثابت ت_التالي_أو_اقفز = ٣٦
ثابت ت_ارمِ = ٣٧
ثابت ت_هيئ_المحاولة = ٣٨
ثابت ت_أنه_المحاولة = ٣٩
ثابت ت_نهاية_أخيرا = ٤٠
ثابت ت_ادخل_نطاقا = ٤١
ثابت ت_ارم_خطأ = ٤٢
ثابت ت_اقفز_إن_صدق = ٤٣

# التعليمات التي وسيطها موضع في الشيفرة
ثابت تعليمات_القفز = [١٩، ٢٠، ٢١، ٢٢، ٣٦، ٤٣]
ثابت العمليات_الثنائية = [
    "+"، "-"، "*"، "/"، "//"، "%"، "**"، "=="، "!="، "<"، ">"، "<="، ">="، "في"،
]

متغير م_الدالة = عدم          # حالة الدالة التي تُترجَم الآن
متغير م_المراقبون = {}        # اسم ← إحالات من دوال داخلية قد يُعاد ربطها
متغير م_العداد = ٠

دالة م_معرف() {
    م_العداد += ١
    أرجع م_العداد
}

# ترتيب الحقول هو ترتيب bytecode._to_data، وإليه تُحوَّل في م_بيانات
دالة م_مترجمة(اسم، تابع_، برنامج_) {
    إذا (اسم == عدم أو اسم == "") { اسم = "دالة مجهولة" }
    أرجع {
        "اسم": اسم، "وسائط": []، "مطلوبة": ٠، "تابع": تابع_، "برنامج": برنامج_،
        "شيفرة": []، "أسطر": []، "ثوابت": []، "أسماء": []، "خانات": ٠،
        "أسماء_الخانات": []، "وسائط_خلايا": []، "حرة": []، "معالجات": []،
        "خلايا_النطاقات": []، "مداخل": []،
    }
}

دالة م_حالة_دالة(اسم، أب، تابع_، برنامج_) {
    أرجع {
        "معرف": م_معرف()، "ناتج": م_مترجمة(اسم، تابع_، برنامج_)، "أب": أب،
        "نطاق": عدم، "نطاق_الجذر": عدم، "حلقات": []، "محاولات": []،
        "خريطة_الحرة": {}، "خريطة_الثوابت": {}، "خريطة_الأسماء": {}، "عدد_الختام": ٠،
    }
}

دالة م_نطاق(أب، د، فهرس، عام) {
    أرجع {"معرف": م_معرف()، "أسماء": {}، "أب": أب، "دالة": د، "فهرس": فهرس، "عام": عام}
}

# ——— أدوات الإصدار ———

دالة أصدر(أمر، وسيط، سطر) {
    متغير شيفرة = م_الدالة["ناتج"]["شيفرة"]
    متغير موضع_ = طول(شيفرة)
    شيفرة.أضف(أمر، وسيط)
    م_الدالة["ناتج"]["أسطر"].أضف(سطر)
    أرجع موضع_
}

دالة م_هنا() { أرجع طول(م_الدالة["ناتج"]["شيفرة"]) }

دالة م_رقع(موضع_) { م_الدالة["ناتج"]["شيفرة"][موضع_ + ١] = م_هنا() }

# «عشري» يفرّق ٣٫٠ عن ٣ كما يفرّق مفتاح بايثون (نوع القيمة، تمثيلها)
دالة م_ثابت(قيمة، عشري) {
    متغير د = م_الدالة
    متغير صنف_ = نوع(قيمة)
    إذا (صنف_ == "عدد" و عشري) { صنف_ = "عشري" }
    متغير مفتاح = صنف_ + ":" + نص(قيمة)
    إذا (ليس (مفتاح في د["خريطة_الثوابت"])) {
        د["ناتج"]["ثوابت"].أضف(["v"، قيمة])
        د["خريطة_الثوابت"][مفتاح] = طول(د["ناتج"]["ثوابت"]) - ١
    }
    أرجع د["خريطة_الثوابت"][مفتاح]
}

دالة م_ثابت_دالة(ناتج) {
    متغير ثوابت = م_الدالة["ناتج"]["ثوابت"]
    ثوابت.أضف(["fn"، ناتج])
    أرجع طول(ثوابت) - ١
}

دالة م_فهرس_اسم(اسم) {
    متغير د = م_الدالة
    إذا (ليس (اسم في د["خريطة_الأسماء"])) {
        د["ناتج"]["أسماء"].أضف(اسم)
        د["خريطة_الأسماء"][اسم] = طول(د["ناتج"]["أسماء"]) - ١
    }
    أرجع د["خريطة_الأسماء"][اسم]
}

دالة م_ارم_خطأ(رسالة، سطر) { أصدر(ت_ارم_خطأ، م_ثابت(رسالة، خطأ)، سطر) }

# ——— النطاقات والأسماء ———

دالة م_ابدأ_نطاقا(سطر) {
    متغير د = م_الدالة
    متغير خلايا = د["ناتج"]["خلايا_النطاقات"]
    متغير ن = م_نطاق(د["نطاق"]، د، طول(خلايا)، خطأ)
    خلايا.أضف([])
    د["نطاق"] = ن
    إذا (طول(د["حلقات"]) > ٠) { أصدر(ت_ادخل_نطاقا، ن["فهرس"]، سطر) }
    أرجع ن
}

دالة م_أنه_نطاقا() {
    متغير د = م_الدالة
    متغير ن = د["نطاق"]
    متغير خانات = []
    لكل اسم في ن["أسماء"] {
        متغير محلي = ن["أسماء"][اسم]
        إذا (محلي["خلية"]) { خانات.أضف(محلي["خانة"]) }
    }
    د["ناتج"]["خلايا_النطاقات"][ن["فهرس"]] = فرز(خانات)
    د["نطاق"] = ن["أب"]
}

دالة م_صرح(اسم، مثبت) {
    متغير د = م_الدالة
    متغير ناتج = د["ناتج"]
    متغير خانة = ناتج["خانات"]
    ناتج["خانات"] = خانة + ١
    ناتج["أسماء_الخانات"].أضف(اسم)
    متغير محلي = {
        "معرف": م_معرف()، "اسم": اسم، "خانة": خانة، "ثابت": مثبت، "نطاق": د["نطاق"]،
        "دالة": د، "خلية": خطأ، "وسيط": خطأ، "إحالات": []، "تصريحات": []،
    }
    د["نطاق"]["أسماء"][اسم] = محلي
    م_أعد_ربط_المراقبين(اسم، محلي)
    أرجع محلي
}

دالة م_ابحث(اسم) {
    متغير ن = م_الدالة["نطاق"]
    طالما (ن != عدم) {
        إذا (ليس ن["عام"] و اسم في ن["أسماء"]) { أرجع ن["أسماء"][اسم] }
        ن = ن["أب"]
    }
    أرجع عدم
}

# محلّي التقطته دالة داخلية: تعليماته كلها تصير تعليمات خلايا
دالة م_رق(محلي) {
    إذا (محلي["خلية"]) { أرجع عدم }
    محلي["خلية"] = صحيح
    متغير شيفرة = محلي["دالة"]["ناتج"]["شيفرة"]
    لكل موضع_ في محلي["إحالات"] {
        إذا (شيفرة[موضع_] == ت_ادفع_محليا) {
            شيفرة[موضع_] = ت_ادفع_خلية
        } وإلا إذا (شيفرة[موضع_] == ت_خزن_محليا) {
            شيفرة[موضع_] = ت_خزن_خلية
        }
    }
    لكل موضع_ في محلي["تصريحات"] { شيفرة[موضع_] = ت_هيئ_خلية }
    إذا (محلي["وسيط"]) { محلي["دالة"]["ناتج"]["وسائط_خلايا"].أضف(محلي["خانة"]) }
}

# فهرس المتغيّر الحرّ في الدالة «د» الذي يصل إلى «محلي» عبر سلسلة الدوال
دالة م_التقط(د، محلي) {
    متغير خريطة = د["خريطة_الحرة"]
    متغير معرف = محلي["معرف"]
    إذا (معرف في خريطة) { أرجع خريطة[معرف] }
    م_رق(محلي)
    متغير مدخل = عدم
    إذا (د["أب"]["معرف"] == محلي["دالة"]["معرف"]) {
        مدخل = [٠، محلي["خانة"]، محلي["اسم"]]
    } وإلا {
        مدخل = [١، م_التقط(د["أب"]، محلي)، محلي["اسم"]]
    }
    د["ناتج"]["حرة"].أضف(مدخل)
    خريطة[معرف] = طول(د["ناتج"]["حرة"]) - ١
    أرجع خريطة[معرف]
}

دالة م_راقب(اسم، موضع_، محلول، تحميل) {
    متغير د = م_الدالة
    إذا (د["أب"] == عدم) { أرجع عدم }
    متغير سلسلة = []            # معرّفات نطاقات الدوال المحيطة، من الأقرب
    متغير ن = د["نطاق_الجذر"]["أب"]
    طالما (ن != عدم) {
        سلسلة.أضف(ن["معرف"])
        ن = ن["أب"]
    }
    إذا (ليس (اسم في م_المراقبون)) { م_المراقبون[اسم] = [] }
    م_المراقبون[اسم].أضف({
        "دالة": د، "موضع": موضع_، "سلسلة": سلسلة، "محلول": محلول، "تحميل": تحميل،
    })
}

دالة م_أعد_ربط_المراقبين(اسم، محلي) {
    إذا (ليس (اسم في م_المراقبون)) { أرجع عدم }
    متغير هدف = محلي["نطاق"]["معرف"]
    لكل مراقب في م_المراقبون[اسم] {
        متغير سلسلة = مراقب["سلسلة"]
        إذا (ليس (هدف في سلسلة)) { استمر }
        متغير محلول = مراقب["محلول"]
        إذا (محلول != عدم) {
            متغير نطاقه = محلول["نطاق"]["معرف"]
            # الإحالة مربوطة بتعريف أقرب
            إذا (نطاقه في سلسلة و سلسلة.موضع(نطاقه) <= سلسلة.موضع(هدف)) { استمر }
        }
        متغير فهرس = م_التقط(مراقب["دالة"]، محلي)
        متغير شيفرة = مراقب["دالة"]["ناتج"]["شيفرة"]
        إذا (مراقب["تحميل"]) {
            شيفرة[مراقب["موضع"]] = ت_ادفع_حرا
        } وإلا {
            شيفرة[مراقب["موضع"]] = ت_خزن_حرا
        }
        شيفرة[مراقب["موضع"] + ١] = فهرس
        مراقب["محلول"] = محلي
    }
}

دالة م_حمل_اسما(اسم، سطر) {
    متغير محلي = م_ابحث(اسم)
    متغير د = م_الدالة
    إذا (محلي == عدم) {
        متغير موضع_ = أصدر(ت_ادفع_عاما، م_فهرس_اسم(اسم)، سطر)
        م_راقب(اسم، موضع_، عدم، صحيح)
    } وإلا إذا (محلي["دالة"]["معرف"] == د["معرف"]) {
        متغير أمر = ت_ادفع_محليا
        إذا (محلي["خلية"]) { أمر = ت_ادفع_خلية }
        محلي["إحالات"].أضف(أصدر(أمر، محلي["خانة"]، سطر))
    } وإلا {
        متغير موضع_ = أصدر(ت_ادفع_حرا، م_التقط(د، محلي)، سطر)
        م_راقب(اسم، موضع_، محلي، صحيح)
    }
}

# يخزّن قمّة المكدس في اسم موجود (إسناد لا تصريح)
دالة م_خزن_اسما(اسم، سطر) {
    متغير محلي = م_ابحث(اسم)
    متغير د = م_الدالة
    إذا (محلي == عدم) {
        متغير موضع_ = أصدر(ت_خزن_عاما، م_فهرس_اسم(اسم)، سطر)
        م_راقب(اسم، موضع_، عدم، خطأ)
    } وإلا إذا (محلي["ثابت"]) {
        م_ارم_خطأ("«" + اسم + "» ثابت، لا يمكن تغيير قيمته"، سطر)
    } وإلا إذا (محلي["دالة"]["معرف"] == د["معرف"]) {
        متغير أمر = ت_خزن_محليا
        إذا (محلي["خلية"]) { أمر = ت_خزن_خلية }
        محلي["إحالات"].أضف(أصدر(أمر، محلي["خانة"]، سطر))
    } وإلا {
        متغير موضع_ = أصدر(ت_خزن_حرا، م_التقط(د، محلي)، سطر)
        م_راقب(اسم، موضع_، محلي، خطأ)
    }
}

دالة م_أصدر_تصريحا(محلي، سطر) {
    متغير أمر = ت_خزن_محليا
    إذا (محلي["خلية"]) { أمر = ت_هيئ_خلية }
    محلي["تصريحات"].أضف(أصدر(أمر، محلي["خانة"]، سطر))
}

# ——— البرنامج والدوال ———

دالة ترجم_برنامجا(برنامج) {
    م_المراقبون = {}
    متغير د = م_حالة_دالة("<البرنامج>"، عدم، خطأ، صحيح)
    م_الدالة = د
    متغير جذر = م_نطاق(عدم، د، -١، صحيح)
    د["نطاق"] = جذر
    د["نطاق_الجذر"] = جذر
    متغير جمل = برنامج["جمل"]
    متغير آخر_سطر = ١
    إذا (طول(جمل) > ٠) { آخر_سطر = جمل[-١]["سطر"] }
    لكل جملة_ في جمل { م_جملة(جملة_) }
    أصدر(ت_ادفع_ثابتا، م_ثابت(عدم، خطأ)، آخر_سطر)
    أصدر(ت_أرجع، ٠، آخر_سطر)
    د["ناتج"]["مداخل"] = [٠]
    # بعد اكتمال البرنامج كلّه فقط: إعادة الربط قد تُعدّل دالة منتهية حتى آخر سطر
    م_احذف_الفارغة(د["ناتج"])
    أرجع د["ناتج"]
}

دالة م_دالة(اسم، معاملات، جسم، سطر، تابع_) {
    متغير أب = م_الدالة
    متغير د = م_حالة_دالة(اسم، أب، تابع_، خطأ)
    م_الدالة = د
    متغير جذر = م_نطاق(أب["نطاق"]، د، ٠، خطأ)
    د["نطاق_الجذر"] = جذر
    د["نطاق"] = جذر
    متغير ناتج = د["ناتج"]
    ناتج["خلايا_النطاقات"].أضف([])

    إذا (تابع_) {
        متغير هذا_ = م_صرح("هذا"، خطأ)
        هذا_["وسيط"] = صحيح
    }
    متغير مطلوبة = ٠
    لكل معامل في معاملات {
        ناتج["وسائط"].أضف(معامل[٠])
        إذا (معامل[١] == عدم) { مطلوبة += ١ }
    }
    ناتج["مطلوبة"] = مطلوبة

    لكل معامل في معاملات[:مطلوبة] {
        متغير محلي = م_صرح(معامل[٠]، خطأ)
        محلي["وسيط"] = صحيح
    }
    متغير مداخل = []
    لكل معامل في معاملات[مطلوبة:] {
        مداخل.أضف(م_هنا())
        إذا (معامل[١] == عدم) {
            أصدر(ت_ادفع_ثابتا، م_ثابت(عدم، خطأ)، سطر)
        } وإلا {
            م_تعبير(معامل[١])
        }
        متغير محلي = م_صرح(معامل[٠]، خطأ)
        محلي["وسيط"] = صحيح
        م_أصدر_تصريحا(محلي، سطر)
    }
    مداخل.أضف(م_هنا())
    ناتج["مداخل"] = مداخل

    لكل جملة_ في جسم["جمل"] { م_جملة(جملة_) }
    متغير سطر_النهاية = سطر
    إذا (طول(جسم["جمل"]) > ٠) { سطر_النهاية = جسم["جمل"][-١]["سطر"] }
    أصدر(ت_ادفع_ثابتا، م_ثابت(عدم، خطأ)، سطر_النهاية)
    أصدر(ت_أرجع، ٠، سطر_النهاية)
    م_أنه_نطاقا()

    م_الدالة = أب
    أصدر(ت_اصنع_دالة، م_ثابت_دالة(ناتج)، سطر)
    أرجع ناتج
}

# ——— الجمل ———

دالة م_جملة(ع) {
    متغير ن = ع["نوع"]
    إذا (ن == "كتلة") { م_كتلة(ع) }
    وإلا إذا (ن == "جملة_تعبير") {
        م_تعبير(ع["تعبير"])
        أصدر(ت_أسقط، ٠، ع["سطر"])
    }
    وإلا إذا (ن == "تصريح") { م_تصريح(ع) }
    وإلا إذا (ن == "تعريف_دالة") {
        م_صرح_مسمى(ع["اسم"]، ع["سطر"]، دالة() {
            م_دالة(ع["اسم"]، ع["وسائط"]، ع["جسم"]، ع["سطر"]، خطأ)
        })
    }
    وإلا إذا (ن == "تعريف_صنف") { م_صنف(ع) }
    وإلا إذا (ن == "إسناد") { م_إسناد(ع) }
    وإلا إذا (ن == "إذا") { م_إذا(ع) }
    وإلا إذا (ن == "طالما") { م_طالما(ع) }
    وإلا إذا (ن == "لكل") { م_لكل(ع) }
    وإلا إذا (ن == "توقف") { م_توقف(ع) }
    وإلا إذا (ن == "استمر") { م_استمر(ع) }
    وإلا إذا (ن == "أرجع") { م_أرجع(ع) }
    وإلا إذا (ن == "ارمِ") {
        م_تعبير(ع["قيمة"])
        أصدر(ت_ارمِ، ٠، ع["سطر"])
    }
    وإلا إذا (ن == "حاول") { م_حاول(ع) }
    وإلا { ارمِ "المترجِم لا يعرف الجملة: " + ن }
}

دالة م_كتلة(ع) {
    م_ابدأ_نطاقا(ع["سطر"])
    لكل جملة_ في ع["جمل"] { م_جملة(جملة_) }
    م_أنه_نطاقا()
}

دالة م_تصريح(ع) {
    متغير اسم = ع["اسم"]
    متغير سطر = ع["سطر"]
    إذا (ع["قيمة"] == عدم) {
        أصدر(ت_ادفع_ثابتا، م_ثابت(عدم، خطأ)، سطر)
    } وإلا {
        م_تعبير(ع["قيمة"])
    }
    إذا (م_الدالة["نطاق"]["عام"]) {
        متغير أمر = ت_عرف_عاما
        إذا (ع["مثبت"]) { أمر = ت_عرف_ثابتا }
        أصدر(أمر، م_فهرس_اسم(اسم)، سطر)
    } وإلا إذا (اسم في م_الدالة["نطاق"]["أسماء"]) {
        م_ارم_خطأ("«" + اسم + "» مُعرَّف مسبقًا في هذا النطاق"، سطر)
    } وإلا {
        م_أصدر_تصريحا(م_صرح(اسم، ع["مثبت"])، سطر)
    }
}

# «دالة» و«صنف»: تستبدلان ما في النطاق بالاسم نفسه كما في المُفسِّر
دالة م_صرح_مسمى(اسم، سطر، ابن) {
    متغير د = م_الدالة
    إذا (د["نطاق"]["عام"]) {
        ابن()
        أصدر(ت_عرف_مستبدلا، م_فهرس_اسم(اسم)، سطر)
        أرجع عدم
    }
    إذا (اسم في د["نطاق"]["أسماء"]) {
        متغير موجود = د["نطاق"]["أسماء"][اسم]
        موجود["ثابت"] = خطأ
        ابن()
        متغير أمر = ت_خزن_محليا
        إذا (موجود["خلية"]) { أمر = ت_خزن_خلية }
        موجود["إحالات"].أضف(أصدر(أمر، موجود["خانة"]، سطر))
    } وإلا {
        متغير محلي = م_صرح(اسم، خطأ)
        ابن()
        م_أصدر_تصريحا(محلي، سطر)
    }
}

دالة م_صنف(ع) {
    متغير سطر = ع["سطر"]
    أصدر(ت_ادفع_ثابتا، م_ثابت(ع["اسم"]، خطأ)، سطر)
    إذا (ع["أب"] != عدم) {                    # الأب يُحَلّ قبل تعريف الاسم
        أصدر(ت_ادفع_ثابتا، م_ثابت(ع["أب"]، خطأ)، سطر)
        م_حمل_اسما(ع["أب"]، سطر)
    }
    # الأسطر داخل الأقواس لا تفصل الجمل، فالدالة تُعرَّف قبل تمريرها
    دالة ابن() {
        لكل تابع_ في ع["توابع"] {
            م_دالة(تابع_["اسم"]، تابع_["وسائط"]، تابع_["جسم"]، تابع_["سطر"]، صحيح)
        }
        متغير عدد_ = طول(ع["توابع"]) * ٢
        إذا (ع["أب"] != عدم) { عدد_ += ١ }
        أصدر(ت_ابن_صنفا، عدد_، سطر)
    }
    م_صرح_مسمى(ع["اسم"]، سطر، ابن)
}

دالة م_إسناد(ع) {
    متغير هدف = ع["هدف"]
    متغير سطر = ع["سطر"]
    متغير عملية = ع["عملية"]
    متغير رقم_العملية = عدم
    إذا (عملية != عدم) { رقم_العملية = العمليات_الثنائية.موضع(عملية) }

    إذا (هدف["نوع"] == "اسم" و عملية != عدم و ع["قيمة"]["نوع"] == "حرفي") {
        # «ع += ١»: حساب ثابت لا أثر له، فيُقرأ الهدف أوّلًا بلا تبديل
        م_حمل_اسما(هدف["اسم"]، سطر)
        م_تعبير(ع["قيمة"])
        أصدر(ت_عملية، رقم_العملية، سطر)
        م_خزن_اسما(هدف["اسم"]، سطر)
        أرجع عدم
    }

    # المُفسِّر يحسب القيمة قبل قراءة الهدف، فالترتيب هنا مثله
    م_تعبير(ع["قيمة"])
    إذا (هدف["نوع"] == "اسم") {
        إذا (عملية != عدم) {
            م_حمل_اسما(هدف["اسم"]، سطر)
            أصدر(ت_بادل، ٠، سطر)
            أصدر(ت_عملية، رقم_العملية، سطر)
        }
        م_خزن_اسما(هدف["اسم"]، سطر)
    } وإلا إذا (هدف["نوع"] == "فهرس") {
        إذا (عملية != عدم) {
            م_تعبير(هدف["كائن"])
            م_تعبير(هدف["مفتاح"])
            أصدر(ت_اجلب_بالفهرس، ٠، سطر)
            أصدر(ت_بادل، ٠، سطر)
            أصدر(ت_عملية، رقم_العملية، سطر)
        }
        م_تعبير(هدف["كائن"])
        م_تعبير(هدف["مفتاح"])
        أصدر(ت_ضع_بالفهرس، ٠، سطر)
    } وإلا {
        إذا (عملية != عدم) {
            م_تعبير(هدف["كائن"])
            أصدر(ت_اجلب_عضوا، م_فهرس_اسم(هدف["اسم"])، سطر)
            أصدر(ت_بادل، ٠، سطر)
            أصدر(ت_عملية، رقم_العملية، سطر)
        }
        م_تعبير(هدف["كائن"])
        أصدر(ت_ضع_عضوا، م_فهرس_اسم(هدف["اسم"])، سطر)
    }
}

# شرط تُهمّ صدقيّته لا قيمته: قفزات مباشرة بدل حساب القيمة ثم فحصها. يُرجع
# مواضع القفزات التي تُنفَّذ حين تكون صدقيّة الشرط «قفز_إن» ليرقّعها المُنادي
دالة م_شرط(ع، قفز_إن) {
    إذا (ع["نوع"] == "أحادي" و ع["عملية"] == "ليس") {
        أرجع م_شرط(ع["معامل"]، ليس قفز_إن)
    }
    إذا (ع["نوع"] == "منطقي") {
        # «أ و ب» كاذبة إن كذب أ؛ «أ أو ب» صادقة إن صدق أ
        متغير قيمة_الاختصار = ع["عملية"] == "أو"
        إذا (قيمة_الاختصار == قفز_إن) {
            متغير رقع_ = م_شرط(ع["يسار"]، قفز_إن)
            أرجع رقع_ + م_شرط(ع["يمين"]، قفز_إن)
        }
        متغير تخط = م_شرط(ع["يسار"]، ليس قفز_إن)
        متغير رقع_ = م_شرط(ع["يمين"]، قفز_إن)
        لكل موضع_ في تخط { م_رقع(موضع_) }
        أرجع رقع_
    }
    م_تعبير(ع)
    متغير أمر = ت_اقفز_إن_كذب
    إذا (قفز_إن) { أمر = ت_اقفز_إن_صدق }
    أرجع [أصدر(أمر، ٠، ع["سطر"])]
}

دالة م_إذا(ع) {
    متغير إلى_البديل = م_شرط(ع["شرط"]، خطأ)
    م_جملة(ع["ثم"])
    إذا (ع["بديل"] == عدم) {
        لكل موضع_ في إلى_البديل { م_رقع(موضع_) }
        أرجع عدم
    }
    متغير إلى_النهاية = أصدر(ت_اقفز، ٠، ع["سطر"])
    لكل موضع_ في إلى_البديل { م_رقع(موضع_) }
    م_جملة(ع["بديل"])
    م_رقع(إلى_النهاية)
}

دالة م_حلقة(بداية، مكرر) {
    أرجع {"استمرار": بداية، "توقفات": []، "عمق_المحاولات": طول(م_الدالة["محاولات"])،
          "مكرر": مكرر}
}

دالة م_أسقط_حلقة() { م_الدالة["حلقات"] = م_الدالة["حلقات"][:-١] }

دالة م_طالما(ع) {
    متغير د = م_الدالة
    متغير بداية = م_هنا()
    متغير إلى_الخروج = م_شرط(ع["شرط"]، خطأ)
    متغير حلقة = م_حلقة(بداية، خطأ)
    د["حلقات"].أضف(حلقة)
    م_كتلة(ع["جسم"])
    م_أسقط_حلقة()
    أصدر(ت_اقفز، بداية، ع["سطر"])
    لكل موضع_ في إلى_الخروج + حلقة["توقفات"] { م_رقع(موضع_) }
}

دالة م_لكل(ع) {
    متغير د = م_الدالة
    متغير سطر = ع["سطر"]
    م_تعبير(ع["مكرر"])
    أصدر(ت_ابدأ_التكرار، ٠، سطر)
    متغير بداية = م_هنا()
    متغير إلى_الخروج = أصدر(ت_التالي_أو_اقفز، ٠، سطر)
    متغير حلقة = م_حلقة(بداية، صحيح)
    د["حلقات"].أضف(حلقة)
    م_ابدأ_نطاقا(سطر)
    م_أصدر_تصريحا(م_صرح(ع["اسم"]، خطأ)، سطر)
    لكل جملة_ في ع["جسم"]["جمل"] { م_جملة(جملة_) }
    م_أنه_نطاقا()
    م_أسقط_حلقة()
    أصدر(ت_اقفز، بداية، سطر)
    إذا (طول(حلقة["توقفات"]) > ٠) {           # «توقف» تترك المكرِّر في المكدس
        لكل موضع_ في حلقة["توقفات"] { م_رقع(موضع_) }
        أصدر(ت_أسقط، ٠، سطر)
    }
    م_رقع(إلى_الخروج)
}

# قبل مغادرة كتل «حاول» بقفزة: أزِل مُعالِجاتها وانسخ «أخيرًا»
دالة م_غادر_المحاولات(عمق، سطر، أزل_المعالجات) {
    متغير د = م_الدالة
    متغير محفوظ = د["محاولات"]
    لكل ط في مدى(طول(محفوظ) - ١، عمق - ١، -١) {
        متغير سياق = محفوظ[ط]
        إذا (أزل_المعالجات و (سياق["حالة"] == "جسم" أو سياق["حالة"] == "امسك_أخيرا")) {
            أصدر(ت_أنه_المحاولة، ٠، سطر)
        }
        إذا (سياق["ختام"] != عدم و سياق["حالة"] != "أخيرا") {
            د["محاولات"] = محفوظ[:ط]
            م_كتلة(سياق["ختام"])
        }
    }
    د["محاولات"] = محفوظ
}

دالة م_توقف(ع) {
    متغير حلقات = م_الدالة["حلقات"]
    إذا (طول(حلقات) == ٠) {
        م_ارم_خطأ("«توقف» لا تُستعمل إلا داخل حلقة"، ع["سطر"])
        أرجع عدم
    }
    م_غادر_المحاولات(حلقات[-١]["عمق_المحاولات"]، ع["سطر"]، صحيح)
    حلقات[-١]["توقفات"].أضف(أصدر(ت_اقفز، ٠، ع["سطر"]))
}

دالة م_استمر(ع) {
    متغير حلقات = م_الدالة["حلقات"]
    إذا (طول(حلقات) == ٠) {
        م_ارم_خطأ("«استمر» لا تُستعمل إلا داخل حلقة"، ع["سطر"])
        أرجع عدم
    }
    م_غادر_المحاولات(حلقات[-١]["عمق_المحاولات"]، ع["سطر"]، صحيح)
    أصدر(ت_اقفز، حلقات[-١]["استمرار"]، ع["سطر"])
}

دالة م_أرجع(ع) {
    إذا (ع["قيمة"] == عدم) {
        أصدر(ت_ادفع_ثابتا، م_ثابت(عدم، خطأ)، ع["سطر"])
    } وإلا {
        م_تعبير(ع["قيمة"])
    }
    إذا (م_الدالة["ناتج"]["برنامج"]) {
        م_ارم_خطأ("«أرجع» لا تُستعمل إلا داخل دالة"، ع["سطر"])
        أرجع عدم
    }
    م_غادر_المحاولات(٠، ع["سطر"]، خطأ)
    أصدر(ت_أرجع، ٠، ع["سطر"])
}

دالة م_ادفع_محاولة(حالة، ختام) {
    م_الدالة["محاولات"].أضف({"حالة": حالة، "ختام": ختام})
}

دالة م_أسقط_محاولة() { م_الدالة["محاولات"] = م_الدالة["محاولات"][:-١] }

دالة م_حاول(ع) {
    متغير د = م_الدالة
    متغير ناتج = د["ناتج"]
    متغير سطر = ع["سطر"]
    متغير ختام = ع["ختام"]
    متغير رقم_الختام = د["عدد_الختام"]
    د["عدد_الختام"] = رقم_الختام + ١

    متغير معالج = طول(ناتج["معالجات"])
    ناتج["معالجات"].أضف([-١، -١، رقم_الختام])
    متغير معالج_امسك = عدم
    أصدر(ت_هيئ_المحاولة، معالج، سطر)
    م_ادفع_محاولة("جسم"، ختام)
    م_كتلة(ع["جسم"])
    م_أسقط_محاولة()
    أصدر(ت_أنه_المحاولة، ٠، سطر)
    متغير إلى_ما_بعد = [أصدر(ت_اقفز، ٠، سطر)]

    إذا (ع["معالج"] != عدم) {
        ناتج["معالجات"][معالج][٠] = م_هنا()
        م_ابدأ_نطاقا(سطر)
        إذا (ع["اسم_الخطأ"] != عدم) {
            م_أصدر_تصريحا(م_صرح(ع["اسم_الخطأ"]، خطأ)، سطر)
        } وإلا {
            أصدر(ت_أسقط، ٠، سطر)
        }
        متغير حالة = "امسك"
        إذا (ختام != عدم) {                   # خطأ داخل «امسك» يمرّ بـ«أخيرًا»
            معالج_امسك = طول(ناتج["معالجات"])
            ناتج["معالجات"].أضف([-١، -١، رقم_الختام])
            أصدر(ت_هيئ_المحاولة، معالج_امسك، سطر)
            حالة = "امسك_أخيرا"
        }
        م_ادفع_محاولة(حالة، ختام)
        لكل جملة_ في ع["معالج"]["جمل"] { م_جملة(جملة_) }
        م_أسقط_محاولة()
        إذا (ختام != عدم) { أصدر(ت_أنه_المحاولة، ٠، سطر) }
        م_أنه_نطاقا()
        إلى_ما_بعد.أضف(أصدر(ت_اقفز، ٠، سطر))
    }

    إذا (ختام != عدم) {
        متغير طريق_الخطأ = م_هنا()
        ناتج["معالجات"][معالج][١] = طريق_الخطأ
        إذا (معالج_امسك != عدم) { ناتج["معالجات"][معالج_امسك][١] = طريق_الخطأ }
        م_ادفع_محاولة("أخيرا"، عدم)
        م_كتلة(ختام)
        م_أسقط_محاولة()
        أصدر(ت_نهاية_أخيرا، رقم_الختام، سطر)
        لكل موضع_ في إلى_ما_بعد { م_رقع(موضع_) }
        م_ادفع_محاولة("أخيرا"، عدم)
        م_كتلة(ختام)
        م_أسقط_محاولة()
    } وإلا {
        لكل موضع_ في إلى_ما_بعد { م_رقع(موضع_) }
    }
}

# ——— التعابير ———

دالة م_تعبير(ع) {
    متغير ن = ع["نوع"]
    متغير سطر = ع["سطر"]
    إذا (ن == "حرفي") {
        متغير عشري = "عشري" في ع و ع["عشري"]
        أصدر(ت_ادفع_ثابتا، م_ثابت(ع["قيمة"]، عشري)، سطر)
    } وإلا إذا (ن == "اسم") {
        م_حمل_اسما(ع["اسم"]، سطر)
    } وإلا إذا (ن == "ثنائي") {
        م_تعبير(ع["يسار"])
        م_تعبير(ع["يمين"])
        أصدر(ت_عملية، العمليات_الثنائية.موضع(ع["عملية"])، سطر)
    } وإلا إذا (ن == "نداء") {
        م_تعبير(ع["منادى"])
        لكل وسيط_ في ع["وسائط"] { م_تعبير(وسيط_) }
        أصدر(ت_نادِ، طول(ع["وسائط"])، سطر)
    } وإلا إذا (ن == "عضو") {
        م_تعبير(ع["كائن"])
        أصدر(ت_اجلب_عضوا، م_فهرس_اسم(ع["اسم"])، سطر)
    } وإلا إذا (ن == "فهرس") {
        م_تعبير(ع["كائن"])
        م_تعبير(ع["مفتاح"])
        أصدر(ت_اجلب_بالفهرس، ٠، سطر)
    } وإلا إذا (ن == "منطقي") {
        م_تعبير(ع["يسار"])
        متغير أمر = ت_اقفز_إن_صدق_مبقيا
        إذا (ع["عملية"] == "و") { أمر = ت_اقفز_إن_كذب_مبقيا }
        متغير إلى_النهاية = أصدر(أمر، ٠، سطر)
        أصدر(ت_أسقط، ٠، سطر)
        م_تعبير(ع["يمين"])
        م_رقع(إلى_النهاية)
    } وإلا إذا (ن == "أحادي") {
        م_تعبير(ع["معامل"])
        متغير أمر = ت_موجب
        إذا (ع["عملية"] == "ليس") { أمر = ت_ليس }
        وإلا إذا (ع["عملية"] == "-") { أمر = ت_سالب }
        أصدر(أمر، ٠، سطر)
    } وإلا إذا (ن == "قائمة") {
        لكل عنصر في ع["عناصر"] { م_تعبير(عنصر) }
        أصدر(ت_ابن_قائمة، طول(ع["عناصر"])، سطر)
    } وإلا إذا (ن == "قاموس") {
        لكل زوج في ع["أزواج"] {
            م_تعبير(زوج[٠])
            م_تعبير(زوج[١])
        }
        أصدر(ت_ابن_قاموسا، طول(ع["أزواج"])، سطر)
    } وإلا إذا (ن == "دالة") {
        م_دالة(ع["اسم"]، ع["وسائط"]، ع["جسم"]، سطر، خطأ)
    } وإلا إذا (ن == "هذا") {
        إذا (م_ابحث("هذا") == عدم) {
            م_ارم_خطأ("«هذا» لا تُستعمل إلا داخل تابع"، سطر)
        } وإلا {
            م_حمل_اسما("هذا"، سطر)
        }
    } وإلا إذا (ن == "الأصل") {
        إذا (م_ابحث("هذا") == عدم) {
            م_ارم_خطأ("«الأصل» لا تُستعمل إلا داخل صنف يرث صنفًا آخر"، سطر)
        } وإلا {
            م_حمل_اسما("هذا"، سطر)
            أصدر(ت_الأصل، ٠، سطر)
        }
    } وإلا إذا (ن == "تقطيع") {
        م_تعبير(ع["كائن"])
        متغير قناع = ٠
        إذا (ع["بداية"] != عدم) {
            م_تعبير(ع["بداية"])
            قناع += ١
        }
        إذا (ع["نهاية"] != عدم) {
            م_تعبير(ع["نهاية"])
            قناع += ٢
        }
        أصدر(ت_اقتطع، قناع، سطر)
    } وإلا {
        ارمِ "المترجِم لا يعرف التعبير: " + ن
    }
}

# يحذف «ادخل_نطاقًا» التي لا خلايا في نطاقها ويُعيد حساب القفزات: تُصدَر لكل
# نطاق داخل حلقة قبل أن يُعرف هل سيُلتقط منه شيء، وأغلبها لا يُلتقط منه شيء
دالة م_احذف_الفارغة(ناتج) {
    متغير شيفرة = ناتج["شيفرة"]
    متغير أسطر = ناتج["أسطر"]
    متغير جديدة = []
    متغير أسطر_جديدة = []
    متغير خريطة = {}
    متغير رقم = ٠
    لكل ط في مدى(٠، طول(شيفرة)، ٢) {
        خريطة[ط] = طول(جديدة)
        متغير أمر = شيفرة[ط]
        متغير وسيط = شيفرة[ط + ١]
        متغير سطر = أسطر[رقم]
        رقم += ١
        إذا (أمر == ت_ادخل_نطاقا و طول(ناتج["خلايا_النطاقات"][وسيط]) == ٠) { استمر }
        جديدة.أضف(أمر، وسيط)
        أسطر_جديدة.أضف(سطر)
    }
    خريطة[طول(شيفرة)] = طول(جديدة)

    إذا (طول(جديدة) != طول(شيفرة)) {
        لكل ط في مدى(٠، طول(جديدة)، ٢) {
            إذا (جديدة[ط] في تعليمات_القفز) { جديدة[ط + ١] = خريطة[جديدة[ط + ١]] }
        }
        متغير مداخل = []
        لكل موضع_ في ناتج["مداخل"] { مداخل.أضف(خريطة[موضع_]) }
        ناتج["مداخل"] = مداخل
        متغير معالجات = []
        لكل م في ناتج["معالجات"] {
            متغير امسك_ = -١
            متغير أخيرا_ = -١
            إذا (م[٠] >= ٠) { امسك_ = خريطة[م[٠]] }
            إذا (م[١] >= ٠) { أخيرا_ = خريطة[م[١]] }
            معالجات.أضف([امسك_، أخيرا_، م[٢]])
        }
        ناتج["معالجات"] = معالجات
        ناتج["شيفرة"] = جديدة
        ناتج["أسطر"] = أسطر_جديدة
    }

    لكل ثابت_ في ناتج["ثوابت"] {
        إذا (ثابت_[٠] == "fn") { م_احذف_الفارغة(ثابت_[١]) }
    }
}

# الدالة المُترجَمة ← البنية التي يكتبها «احفظ_مترجما» ملفَّ ‎.noonc
دالة م_بيانات(ناتج) {
    متغير ثوابت = []
    لكل ثابت_ في ناتج["ثوابت"] {
        إذا (ثابت_[٠] == "fn") {
            ثوابت.أضف(["fn"، م_بيانات(ثابت_[١])])
        } وإلا {
            ثوابت.أضف(ثابت_)
        }
    }
    أرجع [
        ناتج["اسم"]، ناتج["وسائط"]، ناتج["مطلوبة"]، ناتج["تابع"]، ناتج["برنامج"]،
        ناتج["شيفرة"]، ناتج["أسطر"]، ثوابت، ناتج["أسماء"]، ناتج["خانات"]،
        ناتج["أسماء_الخانات"]، ناتج["وسائط_خلايا"]، ناتج["حرة"]، ناتج["معالجات"]،
        ناتج["خلايا_النطاقات"]، ناتج["مداخل"]،
    ]
}


# ═══════════════════════════ البرنامج ═══════════════════════════

# كل اسم تعرفه اللغة المضيفة، ومنها صيغ الكتابة البديلة (اقصي، طبق…)؛
# tests/test_selfhost.py يتحقّق أن القائمة كاملة
ثابت الدوال_المدمجة = {
    "اطبع": اطبع، "اقرأ": اقرأ، "طول": طول، "نوع": نوع، "نص": نص، "عدد": عدد،
    "منطقي": منطقي، "قائمة": قائمة، "مدى": مدى، "مجموع": مجموع، "أقصى": أقصى،
    "أدنى": أدنى، "مطلق": مطلق، "جذر": جذر، "تقريب": تقريب، "أرضية": أرضية،
    "سقف": سقف، "فرز": فرز، "عكس": عكس، "طبّق": طبّق، "رشّح": رشّح، "اختزل": اختزل،
    "عشوائي": عشوائي، "وقت": وقت، "من_صنف": من_صنف، "تحقّق": تحقّق،
    "متساويان": متساويان، "أرقام_عربية": أرقام_عربية، "رمز": رمز، "محرف": محرف،
    "اقرأ_ملف": اقرأ_ملف، "وسائط": وسائط، "عضو": عضو، "احفظ_مترجما": احفظ_مترجما، "استورد": استورد، "اخرج": اخرج،
    "باي": باي،
    "اقرا": اقرا، "قائمه": قائمه، "مدي": مدي، "اقصي": اقصي، "ادني": ادني،
    "ارضيه": ارضيه، "طبق": طبق، "رشح": رشح، "تحقق": تحقق،
    "ارقام_عربيه": ارقام_عربيه، "اقرا_ملف": اقرا_ملف،
}

دالة البيئة_العامة() {
    متغير ب = بيئة_جديدة(عدم)
    لكل اسم في الدوال_المدمجة { صرح(ب، اسم، الدوال_المدمجة[اسم]، صحيح) }
    أرجع ب
}

دالة نفذ_برنامجا(برنامج) {
    متغير ب = البيئة_العامة()
    لكل جملة_ في برنامج["جمل"] {
        متغير إشارة = نفذ(جملة_، ب)
        إذا (إشارة != عدم) {
            إذا (إشارة["إشارة"] == "أرجع") {
                خطأ_تشغيل("«أرجع» لا تُستعمل إلا داخل دالة"، إشارة["سطر"])
            }
            إذا (إشارة["إشارة"] == "توقف") {
                خطأ_تشغيل("«توقف» لا تُستعمل إلا داخل حلقة"، إشارة["سطر"])
            }
            خطأ_تشغيل("«استمر» لا تُستعمل إلا داخل حلقة"، إشارة["سطر"])
        }
    }
}

# نصّ الخطأ الذي أنهى البرنامج كما يعرضه المُفسِّر الأصلي؛ وما ليس خطأ «نون» يُرمى ثانية
دالة نص_الخطأ(خ) {
    متغير خطأ_ = طبع_خطأ(خ)
    إذا (نوع(خطأ_) == "قاموس") {
        إذا (علامة_نحوي في خطأ_) {
            أرجع "خطأ نحوي [سطر " + رقم_لاتيني(خطأ_["سطر"]) + "]: " + خطأ_[علامة_نحوي]
        }
        إذا (علامة_خطأ في خطأ_) {
            أرجع "خطأ تشغيل [سطر " + رقم_لاتيني(خطأ_["سطر"]) + "]: " + خطأ_[علامة_خطأ]
        }
        إذا (علامة_رمية في خطأ_) {
            أرجع "قيمة مرميّة لم تُلتقط: " + نص_قيمة(خطأ_[علامة_رمية])
        }
    }
    ارمِ خ
}

# يُرجع نصّ الخطأ الذي أنهى البرنامج، أو عدم
دالة شغل_مصدرا(مصدر) {
    حاول {
        نفذ_برنامجا(حلل_نحويا(حلل_لفظيا(مصدر)))
        أرجع عدم
    } امسك (خ) {
        أرجع نص_الخطأ(خ)
    }
}

# يترجم المصدر ويكتب ملف ‎.noonc؛ يُرجع رسالة النجاح أو نصّ الخطأ النحوي
دالة ترجم_مصدرا(مصدر، مخرج) {
    حاول {
        متغير برنامج = ترجم_برنامجا(حلل_نحويا(حلل_لفظيا(مصدر)))
        متغير حجم = احفظ_مترجما(مخرج، م_بيانات(برنامج))
        أرجع "تُرجم إلى " + مخرج + " (" + رقم_لاتيني(حجم) + " بايت)"
    } امسك (خ) {
        أرجع نص_الخطأ(خ)
    }
}

# مسار الملف المُترجَم الافتراضي: المسار بلا امتداده، ثم ‎.noonc
دالة مسار_مترجم(مسار) {
    متغير ط = طول(مسار) - ١
    طالما (ط >= ٠) {
        متغير ح = مسار[ط]
        إذا (ح == "." ) { أرجع مسار[:ط] + ".noonc" }
        إذا (ح == "/" أو ح == محرف(٩٢)) { توقف }
        ط -= ١
    }
    أرجع مسار + ".noonc"
}


# ═══════════════════════════ البدء ═══════════════════════════

متغير وسائط_المفسر = وسائط()

إذا (طول(وسائط_المفسر) == ٠) {
    اطبع("نون بنون: مُفسِّر «نون» ومترجِمها، مكتوبان بـ«نون»")
    اطبع("الاستعمال: noon selfhost/noon.noon برنامج.noon [وسائط البرنامج…]")
    اطبع("          noon selfhost/noon.noon --ترجم برنامج.noon [مخرج.noonc]")
} وإلا إذا (وسائط_المفسر[٠] == "--دفعة") {
    # برامج كثيرة في تشغيل واحد، بفاصل بعد كل منها؛ تستعمله الاختبارات
    لكل مسار في وسائط_المفسر[١:] {
        متغير خطأ_ = شغل_مصدرا(اقرأ_ملف(مسار))
        إذا (خطأ_ != عدم) { اطبع(خطأ_) }
        أرقام_عربية(خطأ)
        اطبع(فاصل_الدفعة)
    }
} وإلا إذا (وسائط_المفسر[٠] == "--ترجم") {
    # noon selfhost/noon.noon --ترجم برنامج.noon [مخرج.noonc]
    إذا (طول(وسائط_المفسر) < ٢) {
        اطبع("الاستعمال: noon selfhost/noon.noon --ترجم برنامج.noon [مخرج.noonc]")
    } وإلا {
        متغير مخرج = مسار_مترجم(وسائط_المفسر[١])
        إذا (طول(وسائط_المفسر) > ٢) { مخرج = وسائط_المفسر[٢] }
        متغير رسالة = ترجم_مصدرا(اقرأ_ملف(وسائط_المفسر[١])، مخرج)
        اطبع(رسالة)
        إذا (ليس رسالة.يبدأ("تُرجم إلى ")) { اخرج(١) }     # كما يفعل المترجِم الأصلي
    }
} وإلا إذا (وسائط_المفسر[٠] == "--ترجم-دفعة") {
    # برامج كثيرة في تشغيل واحد: الأول مجلّد المخرجات، والملف رقم ن يُكتب ن.noonc
    متغير مجلد = وسائط_المفسر[١]
    متغير رقم = ٠
    لكل مسار في وسائط_المفسر[٢:] {
        اطبع(ترجم_مصدرا(اقرأ_ملف(مسار)، مجلد + "/" + رقم_لاتيني(رقم) + ".noonc"))
        رقم += ١
    }
} وإلا {
    وسائط_البرنامج = وسائط_المفسر[١:]
    متغير خطأ_ = شغل_مصدرا(اقرأ_ملف(وسائط_المفسر[٠]))
    إذا (خطأ_ != عدم) {
        اطبع(خطأ_)
        اخرج(١)
    }
}
