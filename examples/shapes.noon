# الأصناف والوراثة و«الأصل» وتابع «نص»

صنف شكل {
    تهيئة(اسم) {
        هذا.اسم = اسم
    }

    مساحة() {
        ارمِ "على كل شكل أن يحسب مساحته"
    }

    نص() {
        أرجع هذا.اسم + " مساحته " + نص(تقريب(هذا.مساحة()، ٢))
    }
}

صنف مستطيل يرث شكل {
    تهيئة(طول_، عرض) {
        الأصل.تهيئة("مستطيل")
        هذا.طول_ = طول_
        هذا.عرض = عرض
    }

    مساحة() { أرجع هذا.طول_ * هذا.عرض }
}

صنف مربّع يرث مستطيل {
    تهيئة(ضلع) {
        الأصل.تهيئة(ضلع، ضلع)
        هذا.اسم = "مربّع"
    }
}

صنف دائرة يرث شكل {
    تهيئة(نق) {
        الأصل.تهيئة("دائرة")
        هذا.نق = نق
    }

    مساحة() { أرجع باي * هذا.نق ** ٢ }
}

متغير الأشكال = [مستطيل(٣، ٤)، مربّع(٥)، دائرة(٢)]

لكل شكل_ في الأشكال {
    اطبع(شكل_)
}

متغير الكبرى = أقصى(طبّق(دالة(ش) { أرجع ش.مساحة() }، الأشكال))
اطبع("أكبر مساحة:", تقريب(الكبرى، ٢))
اطبع("هل المربّع مستطيل؟", من_صنف(الأشكال[١]، مستطيل))
