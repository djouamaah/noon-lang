# أوّل برنامج بلغة «نون» — المتغيّرات والنصوص والشروط
# شغّله بـ:  python noon.py examples/hello.noon

ثابت الاسم = "العالَم"
متغير العدّ = ٣

اطبع("مرحبًا يا " + الاسم + "!")

طالما (العدّ > ٠) {
    اطبع("العدّ التنازلي:", العدّ)
    العدّ -= ١
}

إذا (العدّ == ٠) {
    اطبع("انطلاق 🚀")
} وإلا {
    اطبع("شيء ما لم يسِر على ما يُرام")
}

# الأرقام العربية-الهندية والأرقام اللاتينية سواء في الشيفرة
اطبع("٢ + 3 =", ٢ + 3)
