# معالجة الأخطاء: «ارمِ» و«حاول/امسك/أخيرًا»

صنف حساب {
    تهيئة(صاحبه، رصيد = ٠) {
        هذا.صاحبه = صاحبه
        هذا.رصيد = رصيد
        هذا.سجل = []
    }

    أودع(مبلغ) {
        إذا (مبلغ <= ٠) {
            ارمِ {"نوع": "مبلغ غير صالح", "رسالة": "الإيداع يجب أن يكون موجبًا"}
        }
        هذا.رصيد += مبلغ
        هذا.سجل.أضف("إيداع " + نص(مبلغ))
        أرجع هذا.رصيد
    }

    اسحب(مبلغ) {
        إذا (مبلغ > هذا.رصيد) {
            ارمِ {"نوع": "رصيد غير كافٍ",
                  "رسالة": "المطلوب " + نص(مبلغ) + " والمتاح " + نص(هذا.رصيد)}
        }
        هذا.رصيد -= مبلغ
        هذا.سجل.أضف("سحب " + نص(مبلغ))
        أرجع هذا.رصيد
    }

    نص() { أرجع "حساب " + هذا.صاحبه + ": " + نص(هذا.رصيد) + " دج" }
}

متغير ح = حساب("هشام"، ١٠٠٠)

لكل عملية في [[ "أودع"، ٥٠٠ ]، [ "اسحب"، ٢٠٠ ]، [ "اسحب"، ٩٠٠٠ ]، [ "أودع"، -٥ ]] {
    حاول {
        متغير التابع = ح[عملية[٠]]
        اطبع("✓"، عملية[٠]، عملية[١]، "→ الرصيد", التابع(عملية[١]))
    } امسك (خطأ_) {
        اطبع("✗ فشلت العملية:", خطأ_["نوع"] + " — " + خطأ_["رسالة"])
    } أخيرًا {
        # تُنفَّذ في الحالتين
    }
}

اطبع(ح)
اطبع("السجلّ:", ح.سجل)

# الأخطاء التي يرميها المُفسِّر تُلتقط أيضًا
حاول {
    اطبع(١ / ٠)
} امسك (خ) {
    اطبع("أمسكنا خطأ المُفسِّر:", خ["رسالة"], "في السطر", خ["سطر"])
}
