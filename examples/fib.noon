# فيبوناتشي بثلاث طرائق: بالتعاود، وبالحلقة، وبحفظ النتائج

دالة فيبو_تعاودي(ن) {
    إذا (ن < ٢) { أرجع ن }
    أرجع فيبو_تعاودي(ن - ١) + فيبو_تعاودي(ن - ٢)
}

دالة فيبو_حلقي(ن) {
    متغير أ = ٠
    متغير ب = ١
    لكل _ في مدى(ن) {
        متغير ج = أ + ب
        أ = ب
        ب = ج
    }
    أرجع أ
}

# الدوال قيم من الدرجة الأولى، والإغلاق (closure) يحفظ الذاكرة المؤقتة
دالة اصنع_مُخزِّنًا(دالة_أصلية) {
    متغير ذاكرة = {}
    أرجع دالة(ن) {
        إذا (ذاكرة.يحتوي(ن)) { أرجع ذاكرة[ن] }
        متغير نتيجة = دالة_أصلية(ن)
        ذاكرة.ضع(ن، نتيجة)
        أرجع نتيجة
    }
}

متغير فيبو_سريع = اصنع_مُخزِّنًا(فيبو_حلقي)

اطبع("تعاودي :", طبّق(فيبو_تعاودي، مدى(١٠)))
اطبع("حلقي   :", طبّق(فيبو_حلقي، مدى(١٠)))
اطبع("سريع   :", فيبو_سريع(٦٠))
