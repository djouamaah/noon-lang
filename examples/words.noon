# تحليل نصّ: القوائم والقواميس وتوابع النصوص

ثابت النصّ = "العلم نور والجهل ظلام والعلم يرفع بيوتا لا عماد لها والعلم زين"

متغير الكلمات = النصّ.تقسيم(" ")
متغير التكرار = {}

لكل كلمة في الكلمات {
    التكرار.ضع(كلمة، التكرار.اجلب(كلمة، ٠) + ١)
}

متغير المفاتيح = فرز(التكرار.مفاتيح()، دالة(ك) { أرجع التكرار[ك] }، صحيح)

اطبع("عدد الكلمات:", طول(الكلمات))
اطبع("الكلمات المختلفة:", طول(المفاتيح))
اطبع("——————————————")

لكل كلمة في المفاتيح.مقطع(٠، ٣) {
    اطبع(كلمة + ":", "▪" * التكرار[كلمة]، التكرار[كلمة])
}

متغير الطويلة = رشّح(دالة(ك) { أرجع طول(ك) > ٤ }، الكلمات)
اطبع("الكلمات الطويلة:", الطويلة)
اطبع("أطولها:", أقصى(طبّق(دالة(ك) { أرجع طول(ك) }، الكلمات)))
