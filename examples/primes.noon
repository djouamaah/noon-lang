# غربال إراتوستينس: الأعداد الأوّلية حتى ١٠٠

دالة غربال(حد) {
    متغير علامات = [صحيح] * (حد + ١)
    علامات[٠] = خطأ
    علامات[١] = خطأ

    متغير ع = ٢
    طالما (ع * ع <= حد) {
        إذا (علامات[ع]) {
            متغير مضاعف = ع * ع
            طالما (مضاعف <= حد) {
                علامات[مضاعف] = خطأ
                مضاعف += ع
            }
        }
        ع += ١
    }

    متغير أوّلية = []
    لكل ن في مدى(حد + ١) {
        إذا (علامات[ن]) { أوّلية.أضف(ن) }
    }
    أرجع أوّلية
}

متغير نتيجة = غربال(١٠٠)
اطبع("عددها:", طول(نتيجة))
اطبع(نتيجة.وصل("، "))
